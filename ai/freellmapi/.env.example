# FreeLLMAPI 环境变量配置
# 复制此文件为 .env 并填入实际值: cp .env.example .env

# === 必填 ===
# AES-256 加密密钥（用于加密存储各提供商 API Key）
# 生成方式: openssl rand -hex 32
ENCRYPTION_KEY=

# 服务端口
PORT=3001

# === 可选 ===
# 统一 API 密钥前缀（默认 freellmapi-）
# API_KEY_PREFIX=freellmapi-

# 日志级别 (debug, info, warn, error)
# LOG_LEVEL=info

# 健康检查间隔（秒）
# HEALTH_CHECK_INTERVAL=300

# 请求最大重试次数
# MAX_RETRIES=20

# 粘性会话超时（秒，多轮对话保持同一模型）
# STICKY_SESSION_TIMEOUT=1800
