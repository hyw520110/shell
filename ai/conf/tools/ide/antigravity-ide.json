{
  "id": "antigravity-ide",
  "name": "Google Antigravity IDE",
  "description": "Google 官方推出的 AI 原生 IDE，内置强大的 Antigravity Agent 和被动式补全体验",
  "category": "ai-ide",
  "tags": ["ai", "ide", "google", "antigravity"],

  "install": {
    "methods": [
      {
        "name": "官方脚本安装",
        "type": "bash",
        "command": "bash \"${SCRIPT_DIR}/scripts/antigravity.sh\" install app",
        "check": "[ -x \"$HOME/.local/bin/antigravity\" ] || [ -d \"$HOME/.local/opt/antigravity-ide\" ]",
        "uninstall": [
          {
            "description": "删除 Antigravity IDE",
            "command": "bash \"${SCRIPT_DIR}/scripts/antigravity.sh\" uninstall app"
          }
        ]
      }
    ],
    "default_method": 0
  },

  "update": {
    "command": "bash \"${SCRIPT_DIR}/scripts/antigravity.sh\" update app",
    "check": "[ -x \"$HOME/.local/bin/antigravity\" ] || [ -d \"$HOME/.local/opt/antigravity-ide\" ]"
  },

  "config": {
    "path": "$HOME/.config/Antigravity/User/settings.json",
    "operations": {
      "view": "cat \"$HOME/.config/Antigravity/User/settings.json\" 2>/dev/null || echo '配置文件不存在'",
      "edit": "${EDITOR:-vim} \"$HOME/.config/Antigravity/User/settings.json\""
    }
  },

  "commands": {
    "start": "\"$HOME/.local/bin/antigravity\" >/dev/null 2>&1 &"
  },

  "status_check": [
    {
      "name": "检查应用",
      "command": "bash \"${SCRIPT_DIR}/scripts/antigravity.sh\" status app"
    }
  ],

  "mcp_servers": {},
  "skills": {},
  "notes": "Antigravity IDE 提供了 Sidebar Chat、Inline Command 和 Antigravity Tab (Autocomplete) 三种 AI 交互模式。"
}
