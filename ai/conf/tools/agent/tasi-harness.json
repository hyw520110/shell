{
  "id": "tasi-harness",
  "name": "Tasi Harness",
  "description": "本地优先的桌面智能体。提供图形化界面，支持本地知识库检索与定时自动化，默认采用保守的本地安全策略。",
  "category": "ai-agent",
  "tags": [
    "ai",
    "npm",
    "desktop",
    "harness"
  ],
  "install": {
    "methods": [
      {
        "name": "源码安装",
        "type": "bash",
        "command": "git clone https://github.com/TasiTech/tasi-harness.git $HOME/tasi-harness && cd $HOME/tasi-harness && npm install",
        "check": "[ -f \"$HOME/tasi-harness/package.json\" ]",
        "uninstall": [
          "rm -rf $HOME/tasi-harness"
        ]
      }
    ],
    "default_method": 0
  },
  "update": {
    "command": "cd $HOME/tasi-harness && git pull --ff-only && npm install",
    "check": "[ -f \"$HOME/tasi-harness/package.json\" ]"
  },
  "process_check": "tasi-harness|start-electron-dev\\.mjs",
  "config": {
    "path": "",
    "operations": {}
  },
  "commands": {
    "start": "cd $HOME/tasi-harness && npm run dev",
    "build": "cd $HOME/tasi-harness && npm run build",
    "package-mac": "cd $HOME/tasi-harness && npm run dist:mac",
    "start-packaged": "open -a 'Tasi Harness'",
    "cli": "/Applications/Tasi\\ Harness.app/Contents/Resources/bin/tasi chat",
    "help": "cd $HOME/tasi-harness && npm run help 2>/dev/null || echo '请查看 README 中的使用说明'"
  },
  "status_check": [
    {
      "name": "检查代码库",
      "command": "[ -f \"$HOME/tasi-harness/package.json\" ] && echo '源码已安装' || echo '未安装 Tasi Harness'"
    }
  ],
  "mcp_servers": {},
  "skills": {},
  "references": {
    "shared_mcp_servers": [],
    "shared_skills": []
  },
  "homepage": "https://github.com/TasiTech/tasi-harness",
  "repository": "https://github.com/TasiTech/tasi-harness",
  "docs": "https://github.com/TasiTech/tasi-harness/blob/main/README.zh-CN.md",
  "notes": "源码安装后使用 npm run dev 启动 Electron 开发版；npm run dist:mac 可构建 macOS 应用。打包后的 macOS 应用提供 tasi chat CLI。"
}
