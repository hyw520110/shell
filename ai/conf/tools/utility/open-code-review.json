{
  "id": "open-code-review",
  "name": "Alibaba Open Code Review",
  "description": "\u963f\u91cc\u5df4\u5df4\u5f00\u6e90\u7684 AI \u6df1\u5ea6\u4ee3\u7801\u5ba1\u67e5\u5de5\u5177\u3002\u7ed3\u5408\u5de5\u7a0b\u903b\u8f91\u4e0e LLM\uff0c\u63d0\u4f9b\u9ad8\u51c6\u786e\u7387\u7684\u7f3a\u9677\u68c0\u6d4b\u548c\u67b6\u6784\u5efa\u8bae\u3002",
  "category": "ai-utility",
  "tags": [
    "\u4ee3\u7801\u5ba1\u67e5",
    "CodeReview",
    "alibaba",
    "CR",
    "\u8d28\u91cf\u4fdd\u8bc1"
  ],
  "install": {
    "methods": [
      {
        "name": "NPM \u5168\u5c40\u5b89\u88c5",
        "type": "npm",
        "command": "npm install -g @alibaba-group/open-code-review --registry {{npm_registry}}",
        "check": "ocr version",
        "uninstall": [
          "npm uninstall -g @alibaba-group/open-code-review"
        ]
      }
    ],
    "default_method": 0
  },
  "update": {
    "command": "npm install -g @alibaba-group/open-code-review --registry {{npm_registry}} --force",
    "check": "ocr version"
  },
  "commands": {
    "review": "ocr review",
    "version": "ocr version",
    "test-llm": "ocr llm test",
    "help": "ocr --help"
  },
  "status_check": [
    {
      "name": "\u68c0\u67e5 CLI",
      "command": "ocr version 2>/dev/null || echo 'OCR \u672a\u5b89\u88c5'"
    },
    {
      "name": "\u68c0\u67e5\u914d\u7f6e",
      "command": "ls -la $HOME/.ocr/config.yaml 2>/dev/null || echo '\u672a\u914d\u7f6e LLM (\u8bf7\u8fd0\u884c ocr config)'"
    }
  ],
  "prompts": {
    "review-changes": "\u4f7f\u7528 ocr review \u5ba1\u67e5\u6211\u5f53\u524d\u7684\u672c\u5730\u53d8\u66f4\uff0c\u91cd\u70b9\u68c0\u67e5\u5b89\u5168\u9690\u60a3\u548c\u6027\u80fd\u74f6\u9888",
    "compare-branches": "\u5ba1\u67e5 main \u5206\u652f\u4e0e\u5f53\u524d\u5206\u652f\u4e4b\u95f4\u7684\u5dee\u5f02\uff1aocr review --from main",
    "setup-guide": "\u5f15\u5bfc\u6211\u5982\u4f55\u914d\u7f6e Open Code Review \u7684 LLM API Key"
  },
  "notes": "\u5b89\u88c5\u540e\u8bf7\u5148\u8fd0\u884c 'ocr config' \u8bbe\u7f6e\u60a8\u7684 LLM \u670d\u52a1\u3002OCR \u9ed8\u8ba4\u4f7f\u7528 Smart Memory \u538b\u7f29\u6280\u672f\uff0c\u80fd\u6709\u6548\u8282\u7701 Token\u3002",
  "homepage": "https://github.com/alibaba/open-code-review",
  "repository": "https://github.com/alibaba/open-code-review",
  "scenarios": [
    "productivity",
    "coding"
  ],
  "default_enabled": true,
  "optional": false,
  "experimental": false
}