{
  "id": "opencode",
  "name": "OpenCode AI",
  "description": "",
  "category": "ai-coding",
  "tags": [
    "ai",
    "npm"
  ],
  "install": {
    "methods": [
      {
        "name": "默认安装",
        "type": "npm",
        "command": "npm install -g opencode-ai --registry {{npm_registry}}",
        "check": true,
        "uninstall": [
          "npm uninstall -g opencode-ai"
        ]
      }
    ],
    "default_method": 0
  },
  "update": {
    "command": "npm install -g opencode-ai --registry {{npm_registry}}",
    "check": true
  },
  "config": {
    "path": "$HOME/.config/opencode/opencode.json",
    "operations": {
      "view": "cat $HOME/.config/opencode/opencode.json 2>/dev/null || echo \"配置文件不存在\"",
      "edit": "${EDITOR:-vim} $HOME/.config/opencode/opencode.json",
      "reset": [
        "cp $HOME/.config/opencode/opencode.json $HOME/.config/opencode/opencode.json.backup.$(date +%Y%m%d_%H%M%S) 2>/dev/null || true",
        "rm -f $HOME/.config/opencode/opencode.json"
      ]
    }
  },
  "commands": {
    "start": "opencode",
    "version": "opencode --version"
  },
  "status_check": [
    {
      "name": "检查版本",
      "command": "opencode --version 2>/dev/null || echo \"未安装\""
    },
    {
      "name": "检查配置",
      "command": "ls -la $HOME/.config/opencode/opencode.json 2>/dev/null || echo \"配置文件不存在；OpenCode v2 使用 ~/.config/opencode/opencode.json(c)\""
    }
  ],
  "mcp_servers": {},
  "skills": {},
  "references": {
    "shared_mcp_servers": [],
    "shared_skills": []
  },
  "notes": "OpenCode v2 使用 ~/.config/opencode/opencode.json(c) 与 mcp.servers 格式（不是旧版 ~/.opencode/settings.json 的 mcpServers）。ai-hub 写入时使用纯 JSON 的 opencode.json，避免改动用户可能带注释的 opencode.jsonc；两者同时存在时 OpenCode 会合并加载。Skills 写入 ~/.config/opencode/skills，OpenCode 自动发现。",
  "post_install": [],
  "post_uninstall": []
}
