{
  "id": "glm",
  "name": "GLM CLI",
  "description": "GLM-4.7/4.6 CLI 工具，与 Claude Code 集成，支持多种 GLM 模型",
  "category": "ai-coding",
  "tags": [
    "ai",
    "bash"
  ],
  "install": {
    "methods": [
      {
        "name": "默认安装",
        "type": "bash",
        "command": "tmp=$(mktemp \"${TMPDIR:-/tmp}/aihub-glm.XXXXXX\") && curl -LsSf 'https://raw.githubusercontent.com/xqsit94/glm/main/install.sh' -o \"$tmp\" && bash \"$tmp\"; rc=$?; rm -f \"$tmp\"; exit $rc",
        "check": true,
        "uninstall": [
          "rm -f ~/.local/bin/glm 2>/dev/null || true"
        ]
      }
    ],
    "default_method": 0
  },
  "update": {
    "command": "tmp=$(mktemp \"${TMPDIR:-/tmp}/aihub-glm.XXXXXX\") && curl -LsSf 'https://raw.githubusercontent.com/xqsit94/glm/main/install.sh' -o \"$tmp\" && bash \"$tmp\"; rc=$?; rm -f \"$tmp\"; exit $rc",
    "check": true
  },
  "config": {
    "path": "$HOME/.glm/config.json",
    "operations": {
      "view": "cat $HOME/.glm/config.json 2>/dev/null || echo \"配置文件不存在\"",
      "edit": "${EDITOR:-vim} $HOME/.glm/config.json",
      "reset": [
        "cp $HOME/.glm/config.json $HOME/.glm/config.json.backup.$(date +%Y%m%d_%H%M%S) 2>/dev/null || true",
        "rm -f $HOME/.glm/config.json"
      ]
    }
  },
  "commands": {
    "start": "glm",
    "version": "glm --version"
  },
  "status_check": [
    {
      "name": "检查版本",
      "command": "glm --version 2>/dev/null || echo \"未安装\""
    },
    {
      "name": "检查配置",
      "command": "ls -la $HOME/.glm/config.json 2>/dev/null || echo \"配置目录不存在\""
    }
  ],
  "mcp_servers": {},
  "skills": {},
  "references": {
    "shared_mcp_servers": [],
    "shared_skills": []
  },
  "notes": "",
  "post_install": [
    {
      "description": "显示安装完成提示",
      "command": "echo \"安装完成！\""
    }
  ],
  "post_uninstall": [
    {
      "description": "清理残留文件",
      "command": "echo \"卸载完成！\""
    }
  ]
}
