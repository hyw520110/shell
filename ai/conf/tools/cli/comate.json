{
  "id": "comate",
  "name": "Comate CLI (文心快码)",
  "description": "Baidu Comate CLI - 文心快码终端 AI 编码助手，基于 @comate/comatecli，支持交互式 TUI 与 Headless 模式，可接入 CI",
  "category": "ai-coding",
  "tags": [
    "ai",
    "coding",
    "npm",
    "china",
    "baidu"
  ],
  "install": {
    "methods": [
      {
        "name": "npm 安装",
        "type": "npm",
        "command": "npm install -g @comate/comatecli --registry {{npm_registry}}",
        "check": "npm list -g @comate/comatecli --depth=0",
        "uninstall": [
          "npm uninstall -g @comate/comatecli"
        ]
      }
    ],
    "default_method": 0
  },
  "update": {
    "command": "npm install -g @comate/comatecli --registry {{npm_registry}} --force",
    "check": "npm list -g @comate/comatecli --depth=0"
  },
  "config": {
    "path": "$HOME/.comate/",
    "operations": {
      "view": "ls -la $HOME/.comate/ 2>/dev/null || echo '配置文件不存在'",
      "edit": "${EDITOR:-vim} $HOME/.comate/",
      "reset": [
        "cp $HOME/.comate/config.json $HOME/.comate/config.json.backup.$(date +%Y%m%d_%H%M%S) 2>/dev/null || true",
        "rm -f $HOME/.comate/config.json"
      ]
    }
  },
  "commands": {
    "start": "comatecli",
    "version": "comatecli --version",
    "login": "comatecli login",
    "status": "comatecli status",
    "run": "comatecli run -q",
    "mode": "comatecli mode",
    "model": "comatecli model list",
    "update": "comatecli update",
    "ping": "comatecli ping",
    "inspect": "comatecli inspect",
    "search": "comatecli search",
    "indexing": "comatecli indexing"
  },
  "status_check": [
    {
      "name": "检查版本",
      "command": "comatecli --version 2>/dev/null || echo '未安装'"
    },
    {
      "name": "检查命令",
      "command": "command -v comatecli 2>/dev/null || echo '未安装'"
    },
    {
      "name": "检查配置",
      "command": "ls -la $HOME/.comate/ 2>/dev/null || echo '配置目录不存在'"
    }
  ],
  "mcp_servers": {},
  "skills": {
    "comate-agent": {
      "name": "Agent 模式",
      "description": "直接实施编码任务，支持多智能体协同",
      "prompts": {
        "code": "使用 Comate Agent 模式进行完整的代码编写和重构任务",
        "refactor": "重构代码模块并添加测试",
        "fix": "查找并修复代码中的问题"
      },
      "dependencies": {
        "system_commands": []
      },
      "install_check": "command -v comatecli"
    },
    "comate-plan": {
      "name": "Plan 模式",
      "description": "先产出计划，批准后再实施",
      "prompts": {
        "plan": "使用 Plan 模式设计代码实现方案",
        "design": "设计系统架构和实现步骤"
      },
      "dependencies": {
        "system_commands": []
      },
      "install_check": "command -v comatecli"
    },
    "comate-goal": {
      "name": "Goal 模式",
      "description": "围绕长期目标自动连续续跑直到完成或阻塞",
      "prompts": {
        "goal": "围绕长期目标自动推进编码任务"
      },
      "dependencies": {
        "system_commands": []
      },
      "install_check": "command -v comatecli"
    }
  },
  "references": {
    "shared_mcp_servers": [],
    "shared_skills": []
  },
  "notes": "环境要求 Node.js >= 20.10。安装后需登录：comatecli login（设备码登录，自动打开浏览器授权；无浏览器环境用 login --no-browser）。支持交互式 TUI 与 Headless 模式（comatecli run -q \"...\"），可与 CI 集成。",
  "post_install": [
    {
      "description": "显示使用提示",
      "command": "echo -e '\\nComate CLI (文心快码) 安装完成！\\n\\n基本用法：\\n  comatecli              # 交互式 TUI\\n  comatecli run -q \"...\"  # 一次性 Headless 提问\\n  comatecli login         # 首次登录（设备码）\\n  comatecli status        # 检查登录态\\n\\n文档: https://cloud.baidu.com/doc/COMATE/s/0mrcv8nsa'"
    }
  ],
  "post_uninstall": [
    {
      "description": "清理残留文件",
      "command": "rm -rf $HOME/.comate $HOME/.agent 2>/dev/null || true"
    }
  ]
}
