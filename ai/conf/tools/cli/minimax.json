{
  "id": "minimax",
  "name": "MiniMax CLI",
  "description": "MiniMax MMX-CLI - 支持文本、图像、视频、语音、音乐、视觉和搜索的统一命令行工具",
  "category": "ai-coding",
  "tags": [
    "ai",
    "npm",
    "multimodal",
    "china"
  ],
  "install": {
    "methods": [
      {
        "name": "npm 全局安装",
        "type": "npm",
        "command": "npm install -g mmx-cli --registry {{npm_registry}}",
        "check": "npm list -g mmx-cli --depth=0",
        "uninstall": [
          "npm uninstall -g mmx-cli"
        ]
      },
      {
        "name": "作为 Agent Skill 安装",
        "type": "npm",
        "command": "npx skills add MiniMax-AI/cli -y -g --registry {{npm_registry}}",
        "check": "npx skills list | grep MiniMax-AI/cli",
        "uninstall": [
          "npx skills remove MiniMax-AI/cli"
        ]
      }
    ],
    "default_method": 0
  },
  "update": {
    "command": "npm install -g mmx-cli@latest --registry {{npm_registry}} --force",
    "check": "npm list -g mmx-cli --depth=0"
  },
  "config": {
    "path": "$HOME/.mmx/config.json",
    "operations": {
      "view": "cat $HOME/.mmx/config.json 2>/dev/null || echo '配置文件不存在'",
      "edit": "${EDITOR:-vim} $HOME/.mmx/config.json",
      "reset": [
        "cp $HOME/.mmx/config.json $HOME/.mmx/config.json.backup.$(date +%Y%m%d_%H%M%S) 2>/dev/null || true",
        "rm -f $HOME/.mmx/config.json"
      ]
    }
  },
  "commands": {
    "start": "mmx",
    "version": "mmx --version",
    "auth": "mmx auth login --api-key",
    "text": "mmx text chat --message",
    "image": "mmx image generate --prompt",
    "video": "mmx video generate --prompt",
    "speech": "mmx speech tts --text",
    "music": "mmx music generate --prompt",
    "vision": "mmx vision analyze --image"
  },
  "status_check": [
    {
      "name": "检查版本",
      "command": "mmx --version 2>/dev/null || echo '未安装'"
    },
    {
      "name": "检查认证",
      "command": "mmx auth status 2>/dev/null || echo '未认证'"
    },
    {
      "name": "检查配置",
      "command": "ls -la $HOME/.mmx/ 2>/dev/null || echo '配置目录不存在'"
    }
  ],
  "mcp_servers": {},
  "skills": {
    "minimax-multimodal": {
      "name": "多模态处理",
      "description": "支持文本、图像、视频、语音、音乐、视觉和搜索的多模态能力",
      "prompts": {
        "text": "使用 MiniMax 文本模型处理文本任务",
        "image": "使用 MiniMax 图像模型生成或处理图像",
        "video": "使用 MiniMax 视频模型生成视频",
        "speech": "使用 MiniMax 语音模型进行语音合成或识别",
        "vision": "使用 MiniMax 视觉模型分析图像内容"
      },
      "dependencies": {
        "system_commands": []
      },
      "install_check": "command -v mmx"
    }
  },
  "references": {
    "shared_mcp_servers": [],
    "shared_skills": []
  },
  "notes": "MiniMax 提供免费额度，支持多种模态。首次使用需要运行 'mmx auth login --api-key sk-xxxxx' 进行认证。支持作为 OpenClaw、Claude Code、Cursor 等 AI Agent 的 Skill 使用。",
  "post_install": [
    {
      "description": "显示认证提示",
      "command": "echo -e '\\nMiniMax CLI 安装完成！\\n首次使用需要认证：\\n  mmx auth login --api-key sk-xxxxx\\n\\n获取 API Key: https://platform.minimax.io'"
    }
  ],
  "post_uninstall": [
    {
      "description": "清理残留文件",
      "command": "rm -rf ~/.mmx 2>/dev/null || true"
    }
  ]
}
