{
  "id": "scientific-agent-skills",
  "name": "Scientific Agent Skills",
  "description": "138 个即用型科学研究技能集合，覆盖生物信息学、化学信息学、药物发现、蛋白质组学、临床研究、医学影像、机器学习、地理空间科学等领域。支持 100+ 科学数据库访问，70+ Python 包优化技能。将 AI Agent 转化为 AI Scientist。",
  "category": "knowledge",
  "tags": [
    "科研",
    "研究",
    "bioinformatics",
    "cheminformatics",
    "drug-discovery",
    "genomics",
    "proteomics",
    "ml",
    "data-analysis"
  ],
  "install": {
    "methods": [
      {
        "name": "npx 安装 (推荐)",
        "type": "npx",
        "command": "npx skills add K-Dense-AI/scientific-agent-skills"
      },
      {
        "name": "GitHub CLI 安装",
        "type": "gh",
        "command": "gh skill install K-Dense-AI/scientific-agent-skills"
      },
      {
        "name": "手动克隆",
        "type": "git",
        "command": "git clone https://github.com/K-Dense-AI/scientific-agent-skills.git"
      }
    ],
    "default_method": 0,
    "post_install": [
      "echo '1. 确保已安装 Python 3.11+ 和 uv 包管理器'",
      "echo '2. 运行 uv --version 验证 uv 安装'",
      "echo '3. 在 Claude Code/Cursor 中使用: 请帮我进行 [科学任务]，使用相关技能'"
    ]
  },
  "domains": {
    "bioinformatics": [
      "序列分析",
      "单细胞 RNA-seq",
      "基因调控网络",
      "变异注释",
      "系统发育分析"
    ],
