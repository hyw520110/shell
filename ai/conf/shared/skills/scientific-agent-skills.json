      "贝叶斯方法"
    ],
    "imaging": [
      "DICOM 处理",
      "全切片图像分析",
      "计算病理学",
      "放射学工作流"
    ],
    "geospatial": [
      "卫星影像处理",
      "GIS 分析",
      "空间统计",
