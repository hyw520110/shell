      "海报/幻灯片制作"
    ]
  },
  "databases": {
    "count": "100+",
    "highlights": [
      "PubChem - 化合物数据库",
      "ChEMBL - 生物活性分子数据库",
      "UniProt - 蛋白质数据库",
      "COSMIC - 癌症体细胞突变数据库",
      "ClinicalTrials.gov - 临床试验数据库",
      "DepMap - 癌细胞系依赖性数据",
      "Hugging Science - 科学数据集和模型"
    ]
  },
  "packages": {
    "count": "70+",
    "highlights": [
      "RDKit - 化学信息学",
      "Scanpy - 单细胞分析",
      "PyTorch Lightning - 深度学习",
      "scikit-learn - 机器学习",
      "BioPython - 生物信息学",
      "PennyLane - 量子计算",
      "Qiskit - 量子计算",
      "OpenMM - 分子动力学",
      "MDAnalysis - 分子动力学分析",
      "scVelo - RNA 速度分析"
    ]
  },
  "requirements": {
    "python": "3.11+ (推荐 3.12+)",
    "uv": "Python 包管理器",
    "agent": "支持 Agent Skills 标准的 Agent (Cursor, Claude Code, Codex, Gemini CLI)"
  },
  "compatibility": {
    "claude_code": true,
    "cursor": true,
    "codex": true,
    "gemini_cli": true,
    "claude_cowork": true
  },
  "commands": {
    "install_uv": "tmp=$(mktemp \"${TMPDIR:-/tmp}/aihub-uv.XXXXXX\") && curl -LsSf https://astral.sh/uv/install.sh -o \"$tmp\" && sh \"$tmp\"; rc=$?; rm -f \"$tmp\"; exit $rc",
    "verify_uv": "uv --version",
    "update_skills": "npx skills update K-Dense-AI/scientific-agent-skills"
  },
  "examples": [
    {
      "task": "药物发现",
      "prompt": "帮我分析这个化合物的 ADMET 属性，并进行虚拟筛选"
    },
    {
      "task": "基因组分析",
      "prompt": "对这个单细胞 RNA-seq 数据进行降维聚类和差异表达分析"
    },
    {
      "task": "文献综述",
      "prompt": "帮我搜索并总结关于 [主题] 的最新研究进展"
    },
    {
      "task": "分子对接",
      "prompt": "对这个蛋白靶点进行分子对接分析"
    }
  ],
  "references": {
