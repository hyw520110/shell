{
  "id": "rtk-mcp",
  "name": "RTK MCP",
  "description": "RTK \u7684 MCP \u6865\u63a5\u670d\u52a1\uff0c\u5c06 shell \u547d\u4ee4\u901a\u8fc7 Rust Token Killer \u8fc7\u6ee4\u540e\u8fd4\u56de\u7ed9 MCP \u5ba2\u6237\u7aef\u3002",
  "category": "ai",
  "scenarios": [
    "context-optimizer"
  ],
  "tags": [
    "Token\u4f18\u5316",
    "\u547d\u4ee4\u8f93\u51fa\u538b\u7f29",
    "MCP",
    "Rust"
  ],
  "default_enabled": false,
  "optional": true,
  "experimental": false,
  "homepage": "https://github.com/ousamabenyounes/rtk-mcp",
  "repository": "https://github.com/ousamabenyounes/rtk-mcp",
  "install": {
    "type": "bash",
    "command": "bash \"${SCRIPT_DIR}/conf/shared/mcp-servers/rtk-mcp/install.sh\" --install",
    "prerequisites": [
      {
        "name": "cargo (Rust)",
        "check": "command -v cargo >/dev/null 2>&1",
        "install_hint": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
      },
      {
        "name": "git",
        "check": "command -v git >/dev/null 2>&1",
        "install_hint": "brew install git"
      }
    ]
  },
  "config": {
    "command": "sh",
    "args": [
      "-c",
      "python3 \"$HOME/.local/share/ai-hub/rtk-mcp/proxy.py\""
    ],
    "transportType": "stdio",
    "env": {}
  },
  "required_tools": [
    "cargo",
    "git"
  ],
  "status_check": [
    {
      "name": "\u68c0\u67e5 RTK",
      "command": "rtk --version 2>/dev/null || echo 'RTK \u672a\u5b89\u88c5'"
    },
    {
      "name": "\u68c0\u67e5 RTK MCP",
      "command": "test -x $HOME/.local/share/ai-hub/rtk-mcp/target/release/rtk-mcp && echo 'RTK MCP \u5df2\u6784\u5efa' || echo 'RTK MCP \u672a\u6784\u5efa'"
    }
  ],
  "tools": [
    {
      "name": "run_command",
      "description": "\u901a\u8fc7 RTK \u538b\u7f29\u540e\u6267\u884c shell \u547d\u4ee4\u5e76\u8fd4\u56de\u8f93\u51fa"
    }
  ],
  "notes": "\u53ef\u9009 MCP\u3002\u5b83\u4f1a\u66b4\u9732\u547d\u4ee4\u6267\u884c\u80fd\u529b\uff0c\u5e94\u53ea\u5728\u53ef\u4fe1\u9879\u76ee\u548c\u53ef\u4fe1 MCP \u5ba2\u6237\u7aef\u4e2d\u542f\u7528\u3002",
  "recommended_scenarios": "\u6839\u636e\u8be5\u5de5\u5177\u7279\u6027\u9002\u7528\u7684\u6700\u4f73\u573a\u666f\uff08\u5f85\u8865\u5145\uff09",
  "unsuitable_scenarios": "\u4e0d\u63a8\u8350\u4f7f\u7528\u8be5\u5de5\u5177\u7684\u573a\u666f\u6216\u5c40\u9650\u6027\uff08\u5f85\u8865\u5145\uff09"
}