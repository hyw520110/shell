{
  "id": "penpot",
  "name": "Penpot MCP Server",
  "description": "Penpot 官方开源 MCP 服务器，支持读取和操作 Penpot 开放标准的 SVG 设计数据及组件系统。",
  "category": "design",
  "install": {
    "type": "npm",
    "command": "npm install -g @penpot/mcp"
  },
  "config": {
    "command": "npx",
    "args": [
      "-y",
      "@penpot/mcp"
    ],
    "transportType": "stdio",
    "env": {
      "PENPOT_ACCESS_TOKEN": "${PENPOT_ACCESS_TOKEN:-}",
      "PENPOT_URL": "${PENPOT_URL:-https://design.penpot.app}"
    }
  },
  "required_tools": [
    "node",
    "npm"
  ],
  "status_check": [
    {
      "name": "检查 Node.js",
      "command": "node --version 2>/dev/null || echo 'Node.js 未安装'"
    }
  ],
  "tools": [
    {
      "name": "get_file",
      "description": "读取 Penpot 文件结构"
    },
    {
      "name": "get_components",
      "description": "获取设计系统和组件"
    }
  ],
  "notes": "需要设置 PENPOT_ACCESS_TOKEN 环境变量。自托管版本需额外配置 PENPOT_URL。",
  "tags": [
    "设计",
    "Penpot",
    "开源",
    "UI/UX"
  ],
  "scenarios": [
    "design-prototype",
    "productivity"
  ],
  "default_enabled": false,
  "optional": true,
  "experimental": false,
  "homepage": "https://penpot.app/",
  "repository": "https://github.com/penpot/penpot",
  "requires_env": [
    "PENPOT_ACCESS_TOKEN"
  ],
  "recommended_scenarios": "根据该工具特性适用的最佳场景（待补充）",
  "unsuitable_scenarios": "不推荐使用该工具的场景或局限性（待补充）"
}
