#!/bin/bash
# sshm - SSH 连接管理器
# 基于 ~/.ssh/config，支持服务器管理、权限修复、密钥管理
# 合并自 sshm + sshs

set -euo pipefail

# --- 全局变量和常量 ---
SSH_DIR="$HOME/.ssh"
SSH_CONFIG_FILE="$SSH_DIR/config"
KNOWN_HOSTS_FILE="$SSH_DIR/known_hosts"
AUTHORIZED_KEYS_FILE="$SSH_DIR/authorized_keys"
DEBUG_MODE=false
NEED_SUDO=false
CHECK_REACHABLE=false
NO_REACHABLE_CHECK=false
VERBOSE_PERMISSIONS=false
SHOW_KNOWN_HOSTS=false
INSTALL_DIR="$HOME/.local/bin"
REACHABLE_TIMEOUT=1
CONFIG_RESOLVE_TIMEOUT=1
TEST_LOGIN_TIMEOUT=30
SSHM_IP_PREFIX="${SSHM_IP_PREFIX:-192.168}"  # 两段 IP 简写的默认前缀

resolve_script_path() {
    local source="${BASH_SOURCE[0]}"
    local dir target
    while [[ -L "$source" ]]; do
        dir="$(cd -P "$(dirname "$source")" && pwd)"
        target="$(readlink "$source")"
        [[ "$target" != /* ]] && source="$dir/$target" || source="$target"
    done
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    printf "%s/%s\n" "$dir" "$(basename "$source")"
}

SCRIPT_PATH="$(resolve_script_path)"

# 颜色定义（使用 $'...' 兼容 bash/zsh）
C_RESET=$'\033[0m'
C_RED=$'\033[0;31m'
C_GREEN=$'\033[0;32m'
C_YELLOW=$'\033[1;33m'
C_BLUE=$'\033[0;34m'
C_CYAN=$'\033[0;36m'

if [[ ! -t 1 || -n "${NO_COLOR:-}" ]]; then
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
fi

# --- 基础函数 ---
msg()     { printf "${C_BLUE}==>${C_RESET} %s\n" "$*"; }
info()    { printf "%s\n" "$*"; }
success() { printf "${C_GREEN} ✓${C_RESET} %s\n" "$*"; }
warn()    { printf "${C_YELLOW} !${C_RESET} %s\n" "$*"; }
error()   { printf "${C_RED} ✗${C_RESET} %s\n" "$*" >&2; }

run_with_timeout() {
    local seconds="$1"
    shift

    "$@" &
    local cmd_pid=$!
    (
        sleep "$seconds"
        kill "$cmd_pid" 2>/dev/null || true
    ) &
    local timer_pid=$!

    local status
    set +e
    wait "$cmd_pid"
    status=$?
    set -e

    kill "$timer_pid" 2>/dev/null || true
    wait "$timer_pid" 2>/dev/null || true
    return "$status"
}

# --- 权限管理 ---

check_need_sudo() {
    local target="$1"
    if [[ -e "$target" ]]; then
        [[ -O "$target" ]] && return 1
    fi
    if [[ -e "${target%/*}" ]]; then
        [[ -w "${target%/*}" ]] && return 1
    fi
    return 0
}

run_chmod() {
    local perm="$1" target="$2"
    if check_need_sudo "$target"; then
        NEED_SUDO=true
        sudo chmod "$perm" "$target"
    else
        chmod "$perm" "$target"
    fi
}

run_chown() {
    local owner="$1" target="$2"
    if check_need_sudo "$target"; then
        NEED_SUDO=true
        sudo chown "$owner" "$target"
    else
        chown "$owner" "$target"
    fi
}

run_touch() {
    local target="$1"
    if [[ -d "${target%/*}" ]] && ! [[ -w "${target%/*}" ]]; then
        NEED_SUDO=true
        sudo touch "$target"
        sudo chown "$(id -un):$(id -gn)" "$target"
    else
        touch "$target"
    fi
}

get_file_perm() {
    local target="$1"
    if [[ ! -e "$target" ]]; then echo "000"; return; fi
    stat -f "%Lp" "$target" 2>/dev/null || stat -c "%a" "$target" 2>/dev/null || echo "000"
}

get_file_owner() {
    local target="$1"
    if [[ ! -e "$target" ]]; then echo "none"; return; fi
    stat -f "%Su" "$target" 2>/dev/null || stat -c "%U" "$target" 2>/dev/null || echo "unknown"
}

fix_file_permission() {
    local target="$1" expected_perm="$2" description="$3"
    local current_perm current_owner

    if [[ ! -e "$target" ]]; then
        return 0
    fi

    current_perm=$(get_file_perm "$target")
    current_owner=$(get_file_owner "$target")
    local expected_owner
    expected_owner="$(id -un)"

    local need_fix=false
    local fix_reason=""

    if [[ "$current_perm" != "$expected_perm" ]]; then
        need_fix=true
        fix_reason="权限 ${current_perm} → ${expected_perm}"
    fi

    if [[ "$current_owner" != "$expected_owner" ]]; then
        need_fix=true
        fix_reason="${fix_reason:+$fix_reason, }owner ${current_owner} → ${expected_owner}"
    fi

    if [[ "$need_fix" == true ]]; then
        warn "${description}: ${fix_reason}"
        run_chown "$expected_owner:$(id -gn)" "$target"
        run_chmod "$expected_perm" "$target"
        success "${description}: 已修复"
    elif [[ "$DEBUG_MODE" == true ]]; then
        msg "DEBUG: ${description} 权限正常 (${current_perm}, owner: ${current_owner})"
    fi
}

fix_permissions() {
    if $VERBOSE_PERMISSIONS; then
        msg "检查 SSH 文件权限..."
    fi

    local ssh_dir="$HOME/.ssh"
    local current_user
    current_user="$(id -un)"

    # ~/.ssh 目录
    if [[ -d "$ssh_dir" ]]; then
        fix_file_permission "$ssh_dir" "700" "~/.ssh 目录"
    else
        msg "创建 ~/.ssh 目录..."
        mkdir -p "$ssh_dir" 2>/dev/null || {
            NEED_SUDO=true
            sudo mkdir -p "$ssh_dir"
            sudo chown "$current_user:$(id -gn)" "$ssh_dir"
        }
        run_chmod "700" "$ssh_dir"
        success "~/.ssh 目录已创建"
    fi

    # config (600)
    [[ -f "$SSH_CONFIG_FILE" ]] && fix_file_permission "$SSH_CONFIG_FILE" "600" "~/.ssh/config"
    # known_hosts (644)
    [[ -f "$KNOWN_HOSTS_FILE" ]] && fix_file_permission "$KNOWN_HOSTS_FILE" "644" "~/.ssh/known_hosts"
    # authorized_keys (600)
    [[ -f "$AUTHORIZED_KEYS_FILE" ]] && fix_file_permission "$AUTHORIZED_KEYS_FILE" "600" "~/.ssh/authorized_keys"

    # 私钥文件 (400)
    local private_key_patterns=("id_rsa" "id_ed25519" "id_ecdsa" "id_ecdsa_sk" "id_dsa" "id_ed25519_sk" "id_xmss")
    local key_file
    for key_name in "${private_key_patterns[@]}"; do
        key_file="$ssh_dir/$key_name"
        [[ -f "$key_file" ]] && fix_file_permission "$key_file" "400" "~/.ssh/$key_name (私钥)"
    done

    # PEM 私钥 (400)
    for pem_file in "$ssh_dir"/*.pem; do
        [[ -f "$pem_file" ]] || continue
        fix_file_permission "$pem_file" "400" "$pem_file (PEM 私钥)"
    done

    # 公钥文件 (644)
    local pub_key_patterns=("id_rsa.pub" "id_ed25519.pub" "id_ecdsa.pub" "id_ecdsa_sk.pub" "id_dsa.pub" "id_ed25519_sk.pub" "id_xmss.pub")
    for key_name in "${pub_key_patterns[@]}"; do
        key_file="$ssh_dir/$key_name"
        [[ -f "$key_file" ]] && fix_file_permission "$key_file" "644" "~/.ssh/$key_name (公钥)"
    done

    # config 中引用的 IdentityFile
    if [[ -f "$SSH_CONFIG_FILE" ]]; then
        local identity_files
        identity_files=$(grep -i "^[[:space:]]*IdentityFile[[:space:]]" "$SSH_CONFIG_FILE" 2>/dev/null \
            | awk '{print $2}' | sort -u || true)
        for id_file in $identity_files; do
            id_file="${id_file/#\~/$HOME}"
            [[ -f "$id_file" ]] && fix_file_permission "$id_file" "400" "$id_file (IdentityFile)"
            [[ -f "${id_file}.pub" ]] && fix_file_permission "${id_file}.pub" "644" "${id_file}.pub (公钥)"
        done
    fi

    if [[ "$NEED_SUDO" == true ]]; then
        warn "部分文件需要 sudo 提权才能修复权限"
    else
        if $VERBOSE_PERMISSIONS; then
            success "所有 SSH 文件权限正常"
        fi
    fi
    return 0
}

ensure_files_exist() {
    if [[ ! -d "$SSH_DIR" ]]; then
        mkdir -p "$SSH_DIR" 2>/dev/null || {
            sudo mkdir -p "$SSH_DIR"
            sudo chown "$(id -un):$(id -gn)" "$SSH_DIR"
        }
    fi
    [[ ! -f "$SSH_CONFIG_FILE" ]] && run_touch "$SSH_CONFIG_FILE"
    [[ ! -f "$KNOWN_HOSTS_FILE" ]] && run_touch "$KNOWN_HOSTS_FILE"
    fix_permissions
}

# --- 服务器管理 ---

get_configured_hosts() {
    if [[ "$DEBUG_MODE" == true ]]; then
        echo -e "${C_YELLOW}--- DEBUG: get_configured_hosts START ---${C_RESET}" >&2
        cat "$SSH_CONFIG_FILE" >&2 || echo "DEBUG: Could not cat file." >&2
        echo -e "${C_YELLOW}--- DEBUG: get_configured_hosts END ---${C_RESET}" >&2
    fi

    awk '
        tolower($1) == "host" {
            for (i = 2; i <= NF; i++) {
                if ($i !~ /[*?!]/ && !seen[$i]++) {
                    print $i
                }
            }
        }
    ' "$SSH_CONFIG_FILE" 2>/dev/null || true
}

get_discovered_hosts() {
    [[ -f "$KNOWN_HOSTS_FILE" ]] || return 0
    local configured_hosts
    configured_hosts=$(get_configured_hosts)
    awk '{print $1}' "$KNOWN_HOSTS_FILE" | cut -d ',' -f1 | sort -u | grep -vE "^@|\*" | grep -Fvf <(echo "$configured_hosts") || true
}

# 获取指定 Host 的配置信息
get_host_config() {
    local host_name="$1"
    local in_host=false
    local result=""

    while IFS= read -r line; do
        # 去除行首空白
        local trimmed="${line#"${line%%[![:space:]]*}"}"

        if [[ "$trimmed" =~ ^[Hh][Oo][Ss][Tt][[:space:]]+(.*) ]]; then
            local match_host="${BASH_REMATCH[1]}"
            match_host="${match_host#"${match_host%%[![:space:]]*}"}"
            if [[ "$match_host" == "$host_name" ]]; then
                in_host=true
            else
                in_host=false
            fi
        elif $in_host; then
            if [[ "$trimmed" =~ ^[Hh][Oo][Ss][Tt][[:space:]] ]] || [[ -z "$trimmed" ]]; then
                break
            fi
            result+="$trimmed"$'\n'
        fi
    done < "$SSH_CONFIG_FILE"

    echo -n "$result"
}

# 获取 Host 的某个字段值
get_host_field() {
    local host_name="$1"
    local field="$2"
    local config
    config=$(get_host_config "$host_name")
    # 末尾 || true：字段缺失时 grep 返回非零，在 set -o pipefail + errexit 下
    # 会让命令替换触发脚本退出（如主机块未写 Port/HostName 时）
    echo "$config" | grep -i "^[[:space:]]*${field}[[:space:]]" | awk '{print $2}' | head -1 || true
}

get_effective_host_field() {
    local host_name="$1"
    local field="$2"
    run_with_timeout "$CONFIG_RESOLVE_TIMEOUT" ssh -G "$host_name" 2>/dev/null \
        | awk -v field="$field" 'tolower($1) == tolower(field) { print $2; exit }' \
        || true
}

check_tcp_reachable() {
    local hostname="$1"
    local port="$2"

    if command -v perl &>/dev/null; then
        perl -MIO::Socket::INET -e '
            my ($host, $port, $timeout) = @ARGV;
            $SIG{ALRM} = sub { exit 1 };
            alarm($timeout);
            my $sock = IO::Socket::INET->new(
                PeerAddr => $host,
                PeerPort => $port,
                Proto => "tcp",
                Timeout => $timeout,
            );
            alarm(0);
            exit($sock ? 0 : 1);
        ' "$hostname" "$port" "$REACHABLE_TIMEOUT" 2>/dev/null
    elif command -v nc &>/dev/null; then
        if nc -h 2>&1 | grep -q -- "-G"; then
            nc -z -G "$REACHABLE_TIMEOUT" "$hostname" "$port" 2>/dev/null
        else
            nc -z -w "$REACHABLE_TIMEOUT" "$hostname" "$port" 2>/dev/null
        fi
    elif command -v nmap &>/dev/null; then
        nmap -p "$port" "$hostname" | grep -q "open"
    else
        ping -c 1 -W "$REACHABLE_TIMEOUT" "$hostname" &>/dev/null
    fi
}

match_exec_ok() {
    local cmd="$1"
    local cleaned part host port len skip_next=false
    local args=() parts=()

    cleaned="${cmd%%2>*}"
    read -r -a parts <<< "$cleaned"
    for part in "${parts[@]}"; do
        case "$part" in
            nc|-z|-v|-n|-4|-6) ;;
            -w|-G) skip_next=true ;;
            *)
                if [[ "${skip_next:-false}" == true ]]; then
                    skip_next=false
                elif [[ "$part" != -* ]]; then
                    args+=("$part")
                fi
                ;;
        esac
    done

    len=${#args[@]}
    [[ "$len" -ge 2 ]] || return 1
    host="${args[$((len - 2))]}"
    port="${args[$((len - 1))]}"
    check_tcp_reachable "$host" "$port"
}

match_clause_applies() {
    local host_name="$1"
    local clause="$2"
    local match_host match_exec

    [[ "$clause" =~ ^[Mm][Aa][Tt][Cc][Hh][[:space:]]+[Hh][Oo][Ss][Tt][[:space:]]+([^[:space:]]+) ]] || return 1
    match_host="${BASH_REMATCH[1]}"
    [[ "$match_host" == "$host_name" ]] || return 1

    if [[ "$clause" =~ [Ee][Xx][Ee][Cc][[:space:]]+\"([^\"]+)\" ]]; then
        match_exec="${BASH_REMATCH[1]}"
        match_exec_ok "$match_exec"
    else
        return 0
    fi
}

get_match_host_field() {
    local host_name="$1"
    local field="$2"
    local in_match=false

    while IFS= read -r line || [[ -n "$line" ]]; do
        local trimmed="${line#"${line%%[![:space:]]*}"}"

        if [[ "$trimmed" =~ ^[Mm][Aa][Tt][Cc][Hh][[:space:]]+ ]]; then
            if match_clause_applies "$host_name" "$trimmed"; then
                in_match=true
            else
                in_match=false
            fi
        elif [[ "$trimmed" =~ ^[Hh][Oo][Ss][Tt][[:space:]]+ ]]; then
            in_match=false
        elif $in_match; then
            if [[ "$trimmed" =~ ^[[:space:]]*$ ]]; then
                continue
            fi
            echo "$trimmed" | grep -i "^[[:space:]]*${field}[[:space:]]" | awk '{print $2}' | head -1 || true
        fi
    done < "$SSH_CONFIG_FILE"
}

get_resolved_host_field() {
    local host_name="$1"
    local field="$2"
    local value

    value=$(get_host_field "$host_name" "$field")
    if [[ -n "$value" ]]; then
        echo "$value"
        return 0
    fi

    get_match_host_field "$host_name" "$field" | head -1
}

# 检查服务器是否可达
check_server_reachable() {
    local host_name="$1"
    local hostname
    hostname=$(get_resolved_host_field "$host_name" "HostName")
    hostname="${hostname:-$host_name}"
    local port
    port=$(get_resolved_host_field "$host_name" "Port")
    port="${port:-22}"

    check_tcp_reachable "$hostname" "$port"
}

# 判断是否为完整 IPv4 地址。OpenSSH 会把 0.105 这类不完整数字地址
# 解析成 0.0.0.105，因此必须在连接前明确拒绝，避免误连错误主机。
is_complete_ipv4() {
    local host="$1"
    [[ "$host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

is_valid_ipv4_octet() {
    local value="$1"
    [[ "$value" =~ ^[0-9]+$ ]] && ((10#$value <= 255))
}

is_valid_ipv4_prefix() {
    local prefix="$1"
    local first second
    if [[ "$prefix" =~ ^([0-9]+)\.([0-9]+)$ ]]; then
        first="${BASH_REMATCH[1]}"
        second="${BASH_REMATCH[2]}"
        is_valid_ipv4_octet "$first" && is_valid_ipv4_octet "$second"
    else
        return 1
    fi
}

is_incomplete_numeric_host() {
    local host="$1"
    [[ "$host" =~ ^[0-9]+(\.[0-9]+)+$ ]] && ! is_complete_ipv4 "$host"
}

normalize_ip_shorthand() {
    local target="$1"
    local user="" host="$target" first second

    if [[ "$target" == *@* ]]; then
        user="${target%@*}"
        host="${target#*@}"
    fi

    # 只扩展“两段 IP”简写，例如 0.105，不猜测主机名或其它数字别名。
    if [[ "$host" =~ ^([0-9]+)\.([0-9]+)$ ]]; then
        first="${BASH_REMATCH[1]}"
        second="${BASH_REMATCH[2]}"
        if ! is_valid_ipv4_prefix "$SSHM_IP_PREFIX"; then
            error "SSHM_IP_PREFIX 无效: $SSHM_IP_PREFIX，应为两个 0-255 网段，例如 192.168"
            return 1
        fi
        if ! is_valid_ipv4_octet "$first" || ! is_valid_ipv4_octet "$second"; then
            error "IP 简写无效: $host，每段必须是 0-255"
            return 1
        fi
        if [[ -n "$user" ]]; then
            printf '%s@%s.%s.%s\n' "$user" "$SSHM_IP_PREFIX" "$first" "$second"
        else
            printf '%s.%s.%s\n' "$SSHM_IP_PREFIX" "$first" "$second"
        fi
        return 0
    fi

    printf '%s\n' "$target"
}

is_direct_ipv4_target() {
    local target="$1"
    local host="$target"
    [[ "$host" == *@* ]] && host="${host#*@}"
    is_complete_ipv4 "$host"
}

# 直连 IPv4 时自动选择 SSH 端口：优先配置中的非默认端口，否则探测 22/2222。
# 保留 ~/.ssh/config 中的用户名和 IdentityFile；没有用户名配置时使用当前用户。
connect_direct_ipv4() {
    local target="$1"
    local host="$target" user="" configured_user configured_port port

    if [[ "$target" == *@* ]]; then
        user="${target%@*}"
        host="${target#*@}"
    fi

    if ! is_complete_ipv4 "$host"; then
        if is_incomplete_numeric_host "$host"; then
            error "不完整的 IPv4 地址: $host，请输入完整地址，例如 192.168.0.105"
        else
            error "无效的直连 IPv4 地址: $host"
        fi
        return 1
    fi

    configured_user=$(get_resolved_host_field "$host" "User")
    configured_port=$(get_resolved_host_field "$host" "Port")
    user="${user:-${configured_user:-$(id -un)}}"

    if [[ -n "$configured_port" && "$configured_port" != "22" ]]; then
        port="$configured_port"
    elif check_tcp_reachable "$host" 22; then
        port="22"
    elif check_tcp_reachable "$host" 2222; then
        port="2222"
        msg "$host 的 22 端口不可用，自动切换到 2222"
    else
        error "$host 的 22 和 2222 端口均不可达，请使用 sshm -a 配置自定义端口，或直接使用 ssh -p PORT $user@$host"
        return 1
    fi

    msg "正在尝试连接 $user@$host:$port..."
    ssh -p "$port" "$user@$host"
}

connect_target() {
    local target="$1"
    local normalized_target

    normalized_target=$(normalize_ip_shorthand "$target") || return 1
    if [[ "$normalized_target" != "$target" ]]; then
        msg "IP 简写 $target 已解析为 $normalized_target"
    fi

    if is_direct_ipv4_target "$normalized_target" || is_incomplete_numeric_host "${normalized_target#*@}"; then
        connect_direct_ipv4 "$normalized_target"
    else
        ssh "$normalized_target"
    fi
}

# 显示服务器列表
show_servers() {
    local configured_hosts discovered_hosts
    configured_hosts=$(get_configured_hosts)
    if $SHOW_KNOWN_HOSTS; then
        discovered_hosts=$(get_discovered_hosts)
    else
        discovered_hosts=""
    fi

    if [[ -z "$configured_hosts" && -z "$discovered_hosts" ]]; then
        warn "没有找到任何已配置或已发现的服务器。"
        msg "可使用 'sshm -a' 添加服务器。"
        return 1
    fi

    if [[ -n "$configured_hosts" ]]; then
        local i=1
        printf "%-3s %-20s %-12s %s\n" "#" "HOST" "USER" "TARGET"
        for host in $configured_hosts; do
            local hostname port user status
            hostname=$(get_resolved_host_field "$host" "HostName")
            port=$(get_resolved_host_field "$host" "Port")
            user=$(get_resolved_host_field "$host" "User")
            hostname="${hostname:-$host}"
            port="${port:-22}"
            user="${user:-$(id -un)}"

            # 可达性检测
            if $CHECK_REACHABLE; then
                if check_server_reachable "$host" 2>/dev/null; then
                    status=" ${C_GREEN}ok${C_RESET}"
                else
                    status=" ${C_RED}fail${C_RESET}"
                fi
            else
                status=""
            fi

            printf "%-3s %-20s %-12s %s:%s%s\n" "$i" "$host" "$user" "$hostname" "$port" "$status"
            ((i++))
        done
    else
        warn "无。"
    fi

    if $SHOW_KNOWN_HOSTS && [[ -n "$discovered_hosts" ]]; then
        echo ""
        msg "known_hosts"
        for host in $discovered_hosts; do
            echo "  $host"
        done
    fi
    return 0
}

install_command() {
    mkdir -p "$INSTALL_DIR"
    chmod +x "$SCRIPT_PATH" 2>/dev/null || true
    ln -sfn "$SCRIPT_PATH" "$INSTALL_DIR/sshm"
    success "已安装: $INSTALL_DIR/sshm -> $SCRIPT_PATH"

    case ":$PATH:" in
        *":$INSTALL_DIR:"*) ;;
        *)
            warn "$INSTALL_DIR 当前不在 PATH 中"
            msg "添加到 shell 配置后即可任意位置执行: export PATH=\"$INSTALL_DIR:\$PATH\""
            ;;
    esac
}

backup_config() {
    local backup_file
    backup_file="${SSH_CONFIG_FILE}.bak.$(date +%Y%m%d%H%M%S)"
    cp "$SSH_CONFIG_FILE" "$backup_file"
    chmod 600 "$backup_file" 2>/dev/null || true
    msg "已备份 SSH 配置: $backup_file"
}

host_exists() {
    local host_name="$1"
    get_configured_hosts | grep -Fxq "$host_name"
}

remove_host_and_matches() {
    local host_name="$1"
    local tmp
    tmp=$(mktemp)

    awk -v target="$host_name" '
        function host_matches(    i) {
            for (i = 2; i <= NF; i++) {
                if ($i == target) return 1
            }
            return 0
        }
        function match_matches() {
            return tolower($1) == "match" && tolower($2) == "host" && $3 == target
        }
        {
            first = tolower($1)
            if (first == "host") {
                skip = host_matches()
                if (!skip) print
                next
            }
            if (first == "match") {
                skip = match_matches()
                if (!skip) print
                next
            }
            if (!skip) print
        }
    ' "$SSH_CONFIG_FILE" > "$tmp"

    mv "$tmp" "$SSH_CONFIG_FILE"
    chmod 600 "$SSH_CONFIG_FILE" 2>/dev/null || true
}

rewrite_host_block() {
    local host_name="$1"
    local new_hostname="$2"
    local new_user="$3"
    local new_port="$4"
    local tmp
    tmp=$(mktemp)

    awk \
        -v target="$host_name" \
        -v new_hostname="$new_hostname" \
        -v new_user="$new_user" \
        -v new_port="$new_port" '
        function host_matches(    i) {
            for (i = 2; i <= NF; i++) {
                if ($i == target) return 1
            }
            return 0
        }
        function flush_missing() {
            if (!in_target) return
            if (new_hostname != "" && !seen_hostname) print "    HostName " new_hostname
            if (new_user != "" && !seen_user) print "    User " new_user
            if (new_port != "" && !seen_port) print "    Port " new_port
        }
        {
            first = tolower($1)
            if (first == "host") {
                flush_missing()
                in_target = host_matches()
                seen_hostname = 0
                seen_user = 0
                seen_port = 0
                print
                next
            }
            if (first == "match") {
                flush_missing()
                in_target = 0
                print
                next
            }
            if (in_target) {
                key = tolower($1)
                if (key == "hostname") {
                    seen_hostname = 1
                    if (new_hostname != "") {
                        print "    HostName " new_hostname
                        next
                    }
                } else if (key == "user") {
                    seen_user = 1
                    if (new_user != "") {
                        print "    User " new_user
                        next
                    }
                } else if (key == "port") {
                    seen_port = 1
                    if (new_port != "") {
                        print "    Port " new_port
                        next
                    }
                }
            }
            print
        }
        END {
            flush_missing()
        }
    ' "$SSH_CONFIG_FILE" > "$tmp"

    mv "$tmp" "$SSH_CONFIG_FILE"
    chmod 600 "$SSH_CONFIG_FILE" 2>/dev/null || true
}

doctor_config() {
    local issue_count=0
    local duplicates orphans identity_files id_file host alias

    msg "SSH 配置体检"

    duplicates=$(awk '
        tolower($1) == "host" {
            for (i = 2; i <= NF; i++) {
                if ($i !~ /[*?!]/) count[$i]++
            }
        }
        END {
            for (host in count) {
                if (count[host] > 1) print host, count[host]
            }
        }
    ' "$SSH_CONFIG_FILE")
    if [[ -n "$duplicates" ]]; then
        warn "重复 Host:"
        echo "$duplicates" | while read -r host count; do
            [[ -n "$host" ]] && printf "  %s (%s 次)\n" "$host" "$count"
        done
        issue_count=$((issue_count + 1))
    else
        success "未发现重复 Host"
    fi

    orphans=$(awk '
        tolower($1) == "host" {
            for (i = 2; i <= NF; i++) {
                if ($i !~ /[*?!]/) hosts[$i] = 1
            }
        }
        tolower($1) == "match" && tolower($2) == "host" {
            matches[$3] = 1
        }
        END {
            for (host in matches) {
                if (!(host in hosts)) print host
            }
        }
    ' "$SSH_CONFIG_FILE")
    if [[ -n "$orphans" ]]; then
        warn "孤立 Match host:"
        echo "$orphans" | sed 's/^/  /'
        issue_count=$((issue_count + 1))
    else
        success "未发现孤立 Match host"
    fi

    identity_files=$(grep -i "^[[:space:]]*IdentityFile[[:space:]]" "$SSH_CONFIG_FILE" 2>/dev/null \
        | awk '{print $2}' | sort -u || true)
    local missing_identity=false
    for id_file in $identity_files; do
        id_file="${id_file/#\~/$HOME}"
        if [[ ! -f "$id_file" ]]; then
            if [[ "$missing_identity" == false ]]; then
                warn "缺失 IdentityFile:"
                missing_identity=true
                issue_count=$((issue_count + 1))
            fi
            printf "  %s\n" "$id_file"
        fi
    done
    if [[ "$missing_identity" == false ]]; then
        success "IdentityFile 均存在"
    fi

    local unreachable_ip=false
    local target_host target_port
    for host in $(get_configured_hosts); do
        if [[ "$host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            if ! check_server_reachable "$host" 2>/dev/null; then
                if [[ "$unreachable_ip" == false ]]; then
                    warn "当前网络不可达的直连 IP Host:"
                    unreachable_ip=true
                    issue_count=$((issue_count + 1))
                fi
                target_host=$(get_resolved_host_field "$host" "HostName")
                target_port=$(get_resolved_host_field "$host" "Port")
                target_host="${target_host:-$host}"
                target_port="${target_port:-22}"
                printf "  %s -> %s:%s\n" "$host" "$target_host" "$target_port"
            fi
        fi
    done
    if [[ "$unreachable_ip" == false ]]; then
        success "当前网络下直连 IP Host 均可达"
    fi

    local alias_notes=false
    for host in $(get_configured_hosts); do
        alias=$(get_host_field "$host" "HostKeyAlias")
        if [[ -n "$alias" ]] && ssh-keygen -F "$host" -f "$KNOWN_HOSTS_FILE" >/dev/null 2>&1; then
            if [[ "$alias_notes" == false ]]; then
                msg "HostKeyAlias 保护:"
                alias_notes=true
            fi
            printf "  %s 使用 HostKeyAlias %s，忽略该 Host 名下历史 known_hosts 指纹\n" "$host" "$alias"
        fi
    done

    if [[ "$issue_count" -eq 0 ]]; then
        success "doctor 未发现需要处理的问题"
    else
        warn "doctor 发现 $issue_count 类问题"
    fi
}

clean_config() {
    local host confirm cleaned=false

    msg "扫描当前网络不可达的直连 IP Host..."
    for host in $(get_configured_hosts); do
        [[ "$host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
        if check_server_reachable "$host" 2>/dev/null; then
            continue
        fi

        printf "删除不可达 Host '%s'? [y/N] " "$host"
        read -r confirm
        if [[ "$confirm" =~ ^[yY]$ ]]; then
            if [[ "$cleaned" == false ]]; then
                backup_config
                cleaned=true
            fi
            remove_host_and_matches "$host"
            success "已删除 $host"
        else
            info "保留 $host"
        fi
    done

    if [[ "$cleaned" == false ]]; then
        success "未做修改"
    fi
}

test_server() {
    local host_name="$1"
    local hostname port user

    if ! host_exists "$host_name"; then
        error "服务器 '$host_name' 不存在于配置中"
        return 1
    fi

    hostname=$(get_resolved_host_field "$host_name" "HostName")
    port=$(get_resolved_host_field "$host_name" "Port")
    user=$(get_resolved_host_field "$host_name" "User")
    hostname="${hostname:-$host_name}"
    port="${port:-22}"
    user="${user:-$(id -un)}"

    printf "alias  : %s\n" "$host_name"
    printf "target : %s@%s:%s\n" "$user" "$hostname" "$port"

    if check_tcp_reachable "$hostname" "$port"; then
        success "TCP 可达"
    else
        warn "TCP 不可达"
        return 1
    fi

    if run_with_timeout "$TEST_LOGIN_TIMEOUT" ssh -o BatchMode=yes -o ConnectTimeout=8 "$host_name" 'printf "%s@%s\n" "$USER" "$(hostname)"'; then
        success "免密登录成功"
    else
        error "免密登录失败"
        return 1
    fi
}

# 添加新服务器到 ~/.ssh/config
add_server() {
    local alias="${1:-}"

    if [[ -n "$alias" ]]; then
        msg "正在将已发现的主机 '$alias' 添加到配置中..."
    else
        msg "正在添加一个新的服务器..."
    fi

    local configured_hosts
    configured_hosts=$(get_configured_hosts)

    # 获取别名
    if [[ -z "$alias" ]]; then
        while true; do
            printf "为新服务器指定一个别名 (例如: my-server): "
            read -r alias
            if [[ -z "$alias" ]]; then
                error "别名不能为空。"
            elif echo "$configured_hosts" | grep -q -w "$alias"; then
                error "别名 '$alias' 已存在于 ~/.ssh/config。"
            else
                break
            fi
        done
    fi

    printf "请输入主机名或IP地址 (例如: 1.2.3.4): "
    read -r hostname
    printf "请输入用户名 (例如: root): "
    read -r username
    printf "请输入端口号 (默认 22): "
    read -r port
    port="${port:-22}"

    backup_config

    # 写入 ~/.ssh/config
    {
        echo ""
        echo "# Added by sshm on $(date +%Y-%m-%d\ %H:%M:%S)"
        echo "Host $alias"
        echo "    HostName $hostname"
        echo "    User $username"
        echo "    Port $port"
    } >> "$SSH_CONFIG_FILE"

    # 询问是否配置密钥
    printf "是否配置密钥文件? (y/n，默认 n): "
    read -r use_key
    if [[ "${use_key:-n}" =~ ^[yY]$ ]]; then
        printf "请输入私钥文件路径 (例如: ~/.ssh/id_ed25519): "
        read -r key_file
        if [[ -n "$key_file" ]]; then
            key_file="${key_file/#\~/$HOME}"
            echo "    IdentityFile $key_file" >> "$SSH_CONFIG_FILE"
        fi

        # 询问是否自动复制公钥
        printf "是否自动复制公钥到服务器 (ssh-copy-id)? (y/n，默认 y): "
        read -r do_copy
        if [[ "${do_copy:-y}" =~ ^[yY]$ ]]; then
            local pub_key="${key_file}.pub"
            if [[ -f "$pub_key" ]]; then
                if ssh-copy-id -i "$pub_key" "${username}@${hostname}" -p "$port" 2>/dev/null; then
                    success "公钥已复制到 $hostname"
                else
                    warn "公钥复制失败，请手动执行: ssh-copy-id -i $pub_key ${username}@${hostname} -p $port"
                fi
            else
                warn "公钥文件不存在: $pub_key"
            fi
        fi
    else
        # 询问是否自动生成密钥并复制
        printf "是否自动生成密钥并配置免密登录? (y/n，默认 y): "
        read -r auto_key
        if [[ "${auto_key:-y}" =~ ^[yY]$ ]]; then
            local key_path="$SSH_DIR/id_${alias}"
            if [[ -f "$key_path" ]]; then
                warn "密钥已存在: $key_path"
            else
                ssh-keygen -t ed25519 -f "$key_path" -N "" -C "$alias"
                success "密钥已生成: $key_path"
            fi
            echo "    IdentityFile $key_path" >> "$SSH_CONFIG_FILE"
            if ssh-copy-id -i "${key_path}.pub" "${username}@${hostname}" -p "$port" 2>/dev/null; then
                success "公钥已复制到 $hostname，免密登录配置完成"
            else
                warn "公钥复制失败，请手动执行: ssh-copy-id -i ${key_path}.pub ${username}@${hostname} -p $port"
            fi
        fi
    fi

    success "服务器 '$alias' 添加完成"
    return 0
}

# 删除服务器
delete_server() {
    local host_name="$1"

    if ! host_exists "$host_name"; then
        error "服务器 '$host_name' 不存在于配置中"
        return 1
    fi

    printf "确认删除服务器 '%s'? [y/N] " "$host_name"
    read -r confirm
    if [[ ! "$confirm" =~ ^[yY]$ ]]; then
        info "已取消"
        return 0
    fi

    backup_config
    remove_host_and_matches "$host_name"
    success "服务器 '$host_name' 及对应 Match 块已从配置中删除"
}

# 编辑服务器配置
edit_server() {
    local host_name="$1"

    if ! host_exists "$host_name"; then
        error "服务器 '$host_name' 不存在于配置中"
        return 1
    fi

    local hostname port user
    hostname=$(get_host_field "$host_name" "HostName")
    port=$(get_host_field "$host_name" "Port")
    user=$(get_host_field "$host_name" "User")

    msg "当前配置: $user@$hostname:$port"
    echo ""

    printf "新主机名 (当前: %s, 回车保持不变): " "$hostname"
    read -r new_hostname
    printf "新用户名 (当前: %s, 回车保持不变): " "$user"
    read -r new_user
    printf "新端口号 (当前: %s, 回车保持不变): " "$port"
    read -r new_port

    if [[ -z "$new_hostname" && -z "$new_user" && -z "$new_port" ]]; then
        info "未做任何修改"
        return 0
    fi

    backup_config
    rewrite_host_block "$host_name" "$new_hostname" "$new_user" "$new_port"
    success "服务器 '$host_name' 已更新"
}

# 检查密钥是否在 ssh-agent 中
check_key_in_agent() {
    local key_file="$1"
    ssh-add -l 2>/dev/null | grep -q "$key_file"
}

# 添加密钥到 ssh-agent
add_key_to_agent() {
    local key_file="$1"
    if check_key_in_agent "$key_file"; then
        return 0
    fi

    if [[ ! -f "$key_file" ]]; then
        warn "密钥文件不存在: $key_file"
        return 1
    fi

    # 检查是否有密码
    if ssh-keygen -y -P "" -f "$key_file" &>/dev/null; then
        # 无密码密钥
        ssh-add "$key_file" 2>/dev/null && success "密钥已添加到 ssh-agent: $key_file"
    else
        # 有密码密钥
        if command -v expect &>/dev/null; then
            printf "请输入密钥密码: "
            read -rs key_password
            echo ""
            expect -c "
                spawn ssh-add $key_file
                expect \"Enter passphrase:\"
                send \"$key_password\r\"
                expect eof
            " 2>/dev/null && success "密钥已添加到 ssh-agent: $key_file"
        else
            ssh-add "$key_file" 2>/dev/null && success "密钥已添加到 ssh-agent: $key_file"
        fi
    fi
}

# 检测不可达服务器
detect_unreachable_servers() {
    local configured_hosts
    configured_hosts=$(get_configured_hosts)

    if [[ -z "$configured_hosts" ]]; then
        return 0
    fi

    msg "检测服务器可达性..."
    local unreachable=()
    for host in $configured_hosts; do
        if ! check_server_reachable "$host" 2>/dev/null; then
            unreachable+=("$host")
            warn "不可达: $host"
        else
            success "可达: $host"
        fi
    done

    if [[ ${#unreachable[@]} -gt 0 ]]; then
        echo ""
        warn "以下 ${#unreachable[@]} 个服务器不可达"
        printf "是否删除不可达的服务器? [y/N] "
        read -r confirm
        if [[ "$confirm" =~ ^[yY]$ ]]; then
            for host in "${unreachable[@]}"; do
                delete_server "$host"
            done
        fi
    else
        success "所有服务器均可达"
    fi
}

# --- 帮助信息 ---

usage() {
    cat <<EOF
${C_GREEN}sshm${C_RESET} - SSH 连接管理器

${C_YELLOW}用法:${C_RESET}
  sshm [选项] [服务器别名]

${C_YELLOW}选项:${C_RESET}
  -a, --add             交互式添加新服务器
  -d, --delete NAME     删除指定服务器
  -e, --edit NAME       编辑指定服务器配置
  -l, --list            显示所有服务器列表
  doctor                检查重复 Host、孤立 Match、缺失密钥、不可达直连 IP
  clean                 交互清理当前网络不可达的直连 IP Host
  test NAME             测试指定 Host 的解析、TCP 可达性和免密登录
  --known               列表中附带 known_hosts 发现项
  -r, --reachable       启用可达性检测
  -R, --fix-perm        仅修复 SSH 文件权限
  -k, --add-key FILE    添加密钥到 ssh-agent
  --install             安装 sshm 到 ~/.local/bin
  --debug               启用调试模式
  -h, --help            显示帮助信息

${C_YELLOW}示例:${C_RESET}
  sshm                  # 列出服务器并选择连接
  sshm my-server        # 直接连接 my-server
  sshm sky@192.168.0.105 # 直连 IPv4，自动探测 22/2222 端口
  sshm 192.168.0.105    # 使用 SSH 配置中的 User，自动探测 22/2222
  sshm sky@0.105        # 按 SSHM_IP_PREFIX 展开为 sky@192.168.0.105
  SSHM_IP_PREFIX=192.168 sshm 0.105
  sshm -a               # 添加新服务器
  sshm -d my-server     # 删除 my-server
  sshm -e my-server     # 编辑 my-server 配置
  sshm -l               # 列出所有服务器
  sshm -l --known       # 附带显示 known_hosts 发现项
  sshm -l -r            # 列出服务器并检测可达性
  sshm doctor           # 体检 SSH 配置
  sshm clean            # 交互清理不可达直连 IP
  sshm test studio      # 验证 studio 免密登录
  sshm -R               # 修复 SSH 文件权限
  sshm -k ~/.ssh/id_ed25519  # 添加密钥到 ssh-agent
  sshm --install        # 安装命令，之后可在任意目录运行 sshm
EOF
}

# --- 主程序 ---

main() {
    ensure_files_exist

    # 处理全局选项
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debug)
                DEBUG_MODE=true
                VERBOSE_PERMISSIONS=true
                shift
                ;;
            --known)
                SHOW_KNOWN_HOSTS=true
                shift
                ;;
            --)
                shift
                break
                ;;
            -*)
                break
                ;;
            *)
                break
                ;;
        esac
    done

    # 无参数 → 列表 + 选择
    if [[ $# -eq 0 ]]; then
        show_servers || true
        echo ""
        printf "请输入服务器名称进行连接 (或 a=添加, e=编辑, d=删除, q=退出): "
        read -r choice
        case "$choice" in
            a|A) add_server ;;
            e|E)
                printf "请输入要编辑的服务器名称: "
                read -r edit_target
                [[ -n "$edit_target" ]] && edit_server "$edit_target"
                ;;
            d|D)
                printf "请输入要删除的服务器名称: "
                read -r del_target
                [[ -n "$del_target" ]] && delete_server "$del_target"
                ;;
            q|Q|"") msg "再见!"; exit 0 ;;
            *)
                # 检查是否是未配置的主机
                if get_discovered_hosts | grep -q -w "$choice"; then
                    add_server "$choice"
                    printf "是否立即连接? (y/n): "
                    read -r connect_now
                    if [[ ! "$connect_now" =~ ^[yY]$ ]]; then
                        msg "配置已保存，稍后可以使用 'sshm $choice' 连接"
                        exit 0
                    fi
                fi
                connect_target "$choice"
                ;;
        esac
        exit 0
    fi

    # 处理选项
    case "$1" in
        -a|--add)
            add_server
            ;;
        -d|--delete)
            [[ -z "${2:-}" ]] && { error "请指定服务器名称: sshm -d NAME"; exit 1; }
            delete_server "$2"
            ;;
        -e|--edit)
            [[ -z "${2:-}" ]] && { error "请指定服务器名称: sshm -e NAME"; exit 1; }
            edit_server "$2"
            ;;
        doctor|--doctor)
            doctor_config
            ;;
        clean|--clean)
            clean_config
            ;;
        test|--test)
            [[ -z "${2:-}" ]] && { error "请指定服务器名称: sshm test NAME"; exit 1; }
            test_server "$2"
            ;;
        -l|--list)
            shift
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -r|--reachable) CHECK_REACHABLE=true ;;
                    --known) SHOW_KNOWN_HOSTS=true ;;
                    *) break ;;
                esac
                shift
            done
            show_servers
            ;;
        -r|--reachable)
            detect_unreachable_servers
            ;;
        -R|--fix-perm)
            VERBOSE_PERMISSIONS=true
            fix_permissions
            ;;
        -k|--add-key)
            [[ -z "${2:-}" ]] && { error "请指定密钥文件: sshm -k FILE"; exit 1; }
            add_key_to_agent "${2/#\~/$HOME}"
            ;;
        -h|--help)
            usage
            ;;
        --install)
            install_command
            ;;
        -*)
            error "无效选项: $1"
            usage
            exit 1
            ;;
        *)
            # 默认：连接服务器
            connect_target "$1"
            ;;
    esac
}

main "$@"
