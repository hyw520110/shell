#!/usr/bin/env bash
###############################################################################
# envs - 通用环境变量管理脚本
# 功能: 添加/更新/删除环境变量，自动去重 PATH 类变量
# 用法:
#   ./envs install   # 安装到 ~/.local/bin 或 /opt/homebrew/bin
#   ./envs add KEY=VALUE [.zshrc|.bashrc|.zprofile]
#   ./envs remove KEY [.zshrc|.bashrc|.zprofile]
#   ./envs list [.zshrc|.bashrc|.zprofile]
#   ./envs dedup [.zshrc|.bashrc|.zprofile]
#   ./envs init  # 初始化（添加到 shell rc 文件）
###############################################################################

set -euo pipefail

# 颜色输出 - 使用 $'...' 确保转义序列被正确解析
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
NC=$'\033[0m'

info()  { printf "${BLUE}[INFO]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[WARN]${NC} %s\n" "$*"; }
error() { printf "${RED}[ERROR]${NC} %s\n" "$*" >&2; }
success(){ printf "${GREEN}[OK]${NC} %s\n" "$*"; }

# 默认 shell rc 文件
DEFAULT_RC="$HOME/.zshrc"

count_path_exports() {
    local rc="$1"
    grep -c "^export PATH=" "$rc" 2>/dev/null || true
}

# ── 帮助信息 ────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
${GREEN}envs${NC} - 通用环境变量管理脚本

${YELLOW}功能:${NC}
  - 添加/更新环境变量，自动去重 PATH 类变量
  - 移除环境变量
  - 列出所有环境变量
  - 一键修复重复变量

${YELLOW}用法:${NC}
  $(basename "$0") add KEY=VALUE [rc_file]     # 添加或更新变量
  $(basename "$0") set KEY=VALUE [rc_file]     # add 的别名
  $(basename "$0") remove KEY [rc_file]      # 移除变量
  $(basename "$0") list [rc_file]             # 列出所有变量
  $(basename "$0") dedup [rc_file]           # 去重所有 PATH 类变量
  $(basename "$0") fix [rc_file]              # 修复 PATH 问题（合并多行/修复 \$PATH）
  $(basename "$0") install                    # 安装/更新到 ~/.local/bin 或 /opt/homebrew/bin
  $(basename "$0") init                        # 初始化（添加到 shell rc 文件）
  $(basename "$0") backup [rc_file]           # 备份 rc 文件
  $(basename "$0") restore FILE                # 从备份恢复

${YELLOW}示例:${NC}
  $(basename "$0") add OPENAI_API_KEY="none"
  $(basename "$0") add JAVA_HOME="/Library/Java/JavaVirtualMachines/jdk/Contents/Home"
  $(basename "$0") add PATH="/usr/local/bin" ~/.zshrc
  $(basename "$0") remove ANTHROPIC_API_KEY
  $(basename "$0") fix ~/.zshrc               # 检测并修复所有 PATH 问题
  $(basename "$0") dedup ~/.zshrc             # 直接去重（无确认）
  $(basename "$0") init

${YELLOW}说明:${NC}
  - 默认操作 ~/.zshrc
  - PATH, MANPATH, CDPATH 等路径变量会自动去重（保留前一个）
  - 普通目录变量会自动判断是否需要加入 PATH（如 \$JAVA_HOME/bin）
  - 支持引号或不加引号的值
  - 注释行 (# 开头) 不会被修改

EOF
    exit 0
}

# ── 备份 ──────────────────────────────────────────────────────────────────
backup_rc() {
    local rc="${1:-$DEFAULT_RC}"
    local backup="${rc}.backup.$(date +%Y%m%d_%H%M%S)"
    if [[ -f "$rc" ]]; then
        cp "$rc" "$backup"
        success "已备份: $rc → $backup"
    else
        warn "文件不存在: $rc"
    fi
}

# ── 从备份恢复 ─────────────────────────────────────────────────────────────
restore_rc() {
    local backup="$1"
    if [[ ! -f "$backup" ]]; then
        error "备份文件不存在: $backup"
        exit 1
    fi
    
    # 尝试恢复到默认位置
    local rc="$DEFAULT_RC"
    cp "$backup" "$rc"
    success "已恢复: $backup → $rc"
}

# ── 列出所有变量 ───────────────────────────────────────────────────────────
list_vars() {
    local rc="${1:-$DEFAULT_RC}"
    info "环境变量 ($rc):"
    echo ""
    
    if [[ ! -f "$rc" ]]; then
        warn "文件不存在: $rc"
        return
    fi
    
    # 提取 export 行，移除注释
    grep "^export " "$rc" | grep -v "^export #" | sort | while IFS= read -r line; do
        # 解析 KEY=VALUE
        local key="${line#export }"
        key="${key%%=*}"
        key="${key//\"/}"
        key="${key//\'/}"
        
        local value="${line#*=}"
        value="${value//\"/}"
        value="${value//\'/}"
        
        echo "  $key=$value"
    done
}

# ── 检测 PATH 类变量 ────────────────────────────────────────────────────────
is_path_var() {
    local var="$1"
    case "$var" in
        PATH|MANPATH|CDPATH|LD_LIBRARY_PATH|PYTHONPATH|GOPATH|PERL5LIB)
            return 0
            ;;
        *)
            # 也检测以 PATH 结尾的自定义变量
            [[ "$var" == *PATH ]] && return 0
            return 1
            ;;
    esac
}

# ── 添加或更新变量 ─────────────────────────────────────────────────────────
extract_line_key() {
    local line="$1"
    if [[ "$line" =~ ^[[:space:]]*export[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)= ]]; then
        echo "${BASH_REMATCH[1]}"
        return 0
    fi
    if [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)= ]]; then
        echo "${BASH_REMATCH[1]}"
        return 0
    fi
    return 1
}

strip_value_quotes() {
    local value="$1"
    value="${value#\"}"
    value="${value%\"}"
    value="${value#\'}"
    value="${value%\'}"
    echo "$value"
}

extract_line_value() {
    local line="$1"
    local value="${line#*=}"
    strip_value_quotes "$value"
}

add_var() {
    local key value rc
    local kv="$1"
    rc="${2:-$DEFAULT_RC}"
    
    # 解析 KEY=VALUE
    if [[ ! "$kv" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*) ]]; then
        error "无效格式: $kv (格式应为 KEY=VALUE)"
        exit 1
    fi
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    
    # 去除引号
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    
    info "添加/更新: $key=$value (文件: $rc)"
    
    # 确保文件存在
    touch "$rc"
    
    # 检测是否是 PATH 类变量
    local is_path
    is_path_var "$key" && is_path=true || is_path=false
    
    # 临时文件
    local tmp
    tmp=$(mktemp)
    
    # 标记变量是否存在
    local found=false
    local changed=false
    local duplicate_removed=false
    local first_old_value=""
    local new_line="export $key=\"$value\""
    
    # 处理文件
    while IFS= read -r line || [[ -n "$line" ]]; do
        # 跳过空行和注释
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && { echo "$line" >> "$tmp"; continue; }
        
        # 提取 KEY
        local line_key
        line_key=$(extract_line_key "$line" 2>/dev/null || true)
        
        if [[ "$line_key" == "$key" ]]; then
            local old_value target_value
            old_value=$(extract_line_value "$line")
            [[ -z "$first_old_value" ]] && first_old_value="$old_value"

            if $found; then
                duplicate_removed=true
                changed=true
                continue
            fi

            # 找到旧行
            if $is_path; then
                # PATH 类变量：去重合并
                target_value=$(merge_path "$old_value" "$value")
                if [[ "$target_value" != "$old_value" ]]; then
                    info "PATH 去重: 旧值长度=${#old_value}, 新值长度=${#target_value}"
                fi
            else
                target_value="$value"
            fi

            if [[ "$old_value" == "$target_value" ]]; then
                echo "$line" >> "$tmp"
            else
                echo "export $key=\"$target_value\"" >> "$tmp"
                changed=true
            fi
            found=true
        else
            echo "$line" >> "$tmp"
        fi
    done < "$rc"
    
    # 如果变量不存在，追加到末尾
    if ! $found; then
        echo "" >> "$tmp"
        echo "$new_line" >> "$tmp"
        changed=true
    fi
    
    # 替换原文件
    mv "$tmp" "$rc"

    local path_changed=false
    if ensure_path_for_env_var "$key" "$value" "$rc" "$first_old_value"; then
        path_changed=true
    fi

    auto_fix_path "$rc"

    if $duplicate_removed; then
        warn "已移除重复变量定义: $key"
    fi
    if ! $changed && ! $path_changed; then
        success "变量和值未变化，已忽略: $key=$value"
    else
        success "已保存: $key=$value"
    fi
}

dir_has_executable_file() {
    local dir="$1"
    [[ -d "$dir" ]] || return 1
    find "$dir" -maxdepth 1 -type f -perm -111 -print -quit 2>/dev/null | grep -q .
}

infer_path_entry_for_env_var() {
    local key="$1"
    local value="$2"

    [[ "$key" == "PATH" ]] && return 1
    [[ -d "$value" ]] || return 1

    if [[ -d "$value/bin" ]]; then
        echo "\$$key/bin"
        return 0
    fi

    if dir_has_executable_file "$value"; then
        echo "\$$key"
        return 0
    fi

    return 1
}

remove_path_entries_from_value() {
    local value="$1"
    shift || true

    local IFS_old="$IFS"
    local p remove
    local result=()

    IFS=':'
    for p in $value; do
        [[ -z "$p" ]] && continue
        remove=false
        local candidate
        for candidate in "$@"; do
            [[ -n "$candidate" ]] && path_list_contains "$p" "$candidate" && remove=true && break
        done
        $remove && continue
        path_list_contains "$p" "${result[@]-}" || result+=("${p%/}")
    done
    IFS="$IFS_old"

    local IFS=':'
    echo "${result[*]}"
}

ensure_path_entry() {
    local desired="$1"
    local rc="$2"
    shift 2 || true
    local obsolete=("$@")

    [[ -n "$desired" ]] || return 1

    local tmp
    tmp=$(mktemp)
    local found=false
    local changed=false

    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*export[[:space:]]+PATH= ]]; then
            if $found; then
                changed=true
                continue
            fi

            local value cleaned new_value
            value=$(extract_line_value "$line")
            cleaned=$(remove_path_entries_from_value "$value" "${obsolete[@]-}")

            if path_list_contains "$desired" ${cleaned//:/ }; then
                new_value="$cleaned"
            else
                if [[ -n "$cleaned" ]]; then
                    new_value="$desired:$cleaned"
                else
                    new_value="$desired:\$PATH"
                fi
            fi

            new_value=$(rebuild_path_value "$new_value")
            echo "export PATH=\"$new_value\"" >> "$tmp"
            [[ "$new_value" != "$value" ]] && changed=true
            found=true
        else
            echo "$line" >> "$tmp"
        fi
    done < "$rc"

    if ! $found; then
        echo "" >> "$tmp"
        echo "export PATH=\"$desired:\$PATH\"" >> "$tmp"
        changed=true
    fi

    mv "$tmp" "$rc"

    if $changed; then
        info "已更新 PATH: $desired"
        return 0
    fi
    return 1
}

ensure_path_for_env_var() {
    local key="$1"
    local value="$2"
    local rc="$3"
    local old_value="${4:-}"
    local desired

    desired=$(infer_path_entry_for_env_var "$key" "$value" || true)
    [[ -n "$desired" ]] || return 1

    local obsolete=()
    if [[ -n "$old_value" && "$old_value" != "$value" ]]; then
        obsolete+=("$old_value/bin" "$old_value")
    fi

    ensure_path_entry "$desired" "$rc" "${obsolete[@]-}"
}

auto_fix_path() {
    local rc="${1:-$DEFAULT_RC}"
    [[ -f "$rc" ]] || return 0

    local path_count
    path_count=$(count_path_exports "$rc")

    if [[ "$path_count" -gt 1 ]]; then
        dedup_all "$rc"
        return 0
    fi

    local path_line value
    path_line=$(grep "^export PATH=" "$rc" 2>/dev/null || echo "")
    [[ -n "$path_line" ]] || return 0
    value=$(extract_line_value "$path_line")
    if path_value_needs_cleanup "$value"; then
        repair_path "$rc"
    fi
}

# ── 移除变量 ───────────────────────────────────────────────────────────────
remove_var() {
    local key="$1"
    local rc="${2:-$DEFAULT_RC}"
    
    if [[ ! -f "$rc" ]]; then
        warn "文件不存在: $rc"
        return
    fi
    
    info "移除: $key (文件: $rc)"
    
    local tmp
    tmp=$(mktemp)
    local removed=false
    
    while IFS= read -r line; do
        # 跳过空行
        [[ -z "$line" ]] && echo "$line" >> "$tmp" && continue
        
        # 提取 KEY
        local line_key="${line#export }"
        line_key="${line_key%%=*}"
        line_key="${line_key//\"/}"
        line_key="${line_key//\'/}"
        line_key="${line_key// /}"
        
        if [[ "$line_key" == "$key" ]]; then
            removed=true
            success "已移除: $line"
        else
            echo "$line" >> "$tmp"
        fi
    done < "$rc"
    
    mv "$tmp" "$rc"
    
    $removed || warn "变量不存在: $key"
}

# ── 合并 PATH（去重）──────────────────────────────────────────────────────
normalize_path_key() {
    local p="${1%/}"
    case "$p" in
        "~") p="$HOME" ;;
        "~/"*) p="$HOME/${p#~/}" ;;
        '$HOME') p="$HOME" ;;
        '$HOME/'*) p="$HOME/${p#\$HOME/}" ;;
        '${HOME}') p="$HOME" ;;
        '${HOME}/'*) p="$HOME/${p#\$\{HOME\}/}" ;;
    esac
    echo "${p%/}"
}

path_list_contains() {
    local needle
    needle=$(normalize_path_key "$1")
    shift || true

    local p
    for p in "$@"; do
        [[ "$(normalize_path_key "$p")" == "$needle" ]] && return 0
    done
    return 1
}

python_user_bin() {
    local base
    base=$(python3 -m site --user-base 2>/dev/null || true)
    [[ -n "$base" && -d "$base/bin" ]] && echo "$base/bin"
}

path_value_needs_cleanup() {
    local value="$1"
    local before_path="${value%%\$PATH*}"
    local after_path="${value#*\$PATH}"
    local has_middle=false
    local IFS_old="$IFS"
    local p
    local seen=()

    before_path="${before_path%:}"
    after_path="${after_path#:}"

    if [[ "$value" == *'$PATH'* ]] && [[ -n "$before_path" && -n "$after_path" ]]; then
        has_middle=true
    fi

    IFS=':'
    for p in ${value//\$PATH/}; do
        [[ -z "$p" ]] && continue
        if path_list_contains "$p" "${seen[@]-}"; then
            IFS="$IFS_old"
            return 0
        fi
        seen+=("${p%/}")
    done
    IFS="$IFS_old"

    $has_middle && return 0
    return 1
}

rebuild_path_value() {
    local value="$1"
    local before_path="${value%%\$PATH*}"
    local after_path="${value#*\$PATH}"
    local has_path_ref=false
    local starts_with_path=false
    local unique_before=()
    local unique_after=()
    local IFS_old="$IFS"
    local p

    [[ "$value" == *'$PATH'* ]] && has_path_ref=true
    [[ "$value" == '$PATH' || "$value" == '$PATH:'* ]] && starts_with_path=true

    before_path="${before_path%:}"
    after_path="${after_path#:}"

    IFS=':'
    for p in $before_path; do
        [[ -n "$p" ]] && ! path_list_contains "$p" "${unique_before[@]-}" && unique_before+=("${p%/}")
    done
    for p in $after_path; do
        [[ -n "$p" ]] && ! path_list_contains "$p" "${unique_before[@]-}" "${unique_after[@]-}" && unique_after+=("${p%/}")
    done
    IFS="$IFS_old"

    local joined_before=""
    local joined_after=""
    if [[ ${#unique_before[@]} -gt 0 ]]; then
        local IFS=':'
        joined_before="${unique_before[*]}"
        IFS=' '
    fi
    if [[ ${#unique_after[@]} -gt 0 ]]; then
        local IFS=':'
        joined_after="${unique_after[*]}"
        IFS=' '
    fi

    if ! $has_path_ref; then
        local combined=()
        for p in "${unique_before[@]}" "${unique_after[@]}"; do
            [[ -n "$p" ]] && ! path_list_contains "$p" "${combined[@]-}" && combined+=("$p")
        done
        local IFS=':'
        echo "${combined[*]}"
        return 0
    fi

    if $starts_with_path && [[ -z "$joined_before" ]]; then
        [[ -n "$joined_after" ]] && echo "\$PATH:$joined_after" || echo "\$PATH"
        return 0
    fi

    if [[ -n "$joined_before" && -n "$joined_after" ]]; then
        echo "$joined_before:$joined_after:\$PATH"
    elif [[ -n "$joined_before" ]]; then
        echo "$joined_before:\$PATH"
    elif [[ -n "$joined_after" ]]; then
        echo "\$PATH:$joined_after"
    else
        echo "\$PATH"
    fi
}

merge_path() {
    local old_path="$1"
    local new_path="$2"
    
    local IFS_old="$IFS"
    local p
    local result=()

    IFS=':'
    for p in $new_path; do
        [[ -z "$p" ]] && continue
        path_list_contains "$p" "${result[@]-}" || result+=("${p%/}")
    done
    for p in $old_path; do
        [[ -z "$p" ]] && continue
        path_list_contains "$p" "${result[@]-}" || result+=("${p%/}")
    done
    IFS="$IFS_old"
    
    # 重新组合
    local IFS=':'
    echo "${result[*]}"
}

# ── 去重所有 PATH 类变量 ──────────────────────────────────────────────────
dedup_all() {
    local rc="${1:-$DEFAULT_RC}"
    
    if [[ ! -f "$rc" ]]; then
        warn "文件不存在: $rc"
        return
    fi
    
    info "去重所有 PATH 类变量 (文件: $rc)"
    echo ""
    
    # 先备份
    backup_rc "$rc"
    
    # 收集所有 PATH 定义，区分 prepend 和 append
    local prepend_parts=()
    local append_parts=()
    local other_lines=()
    local path_count=0
    
    while IFS= read -r line || [[ -n "$line" ]]; do
        # 检查是否是 PATH 定义行
        if [[ "$line" =~ ^export[[:space:]]+PATH= ]]; then
            # 提取 VALUE
            local value="${line#*=}"
            value="${value#\"}"
            value="${value%\"}"
            value="${value#\'}"
            value="${value%\'}"
            ((path_count++))
            
            # 分割 $PATH 引用，确定是 prepend 还是 append
            # prepend: /path1:/path2:$PATH
            # append: $PATH:/path1:/path2
            
            # 临时移除 $PATH 中的引号进行检测
            local check_value="${value//\"/}"
            if [[ "$check_value" == *'$PATH'* ]]; then
                # 提取 $PATH 之前和之后的路径
                local before_path="${check_value%%\$PATH*}"
                local after_path="${check_value#*\$PATH}"
                
                # 去除尾部的冒号
                before_path="${before_path%:}"
                after_path="${after_path#:}"
                
                # 分割并添加 prepend 部分
                if [[ -n "$before_path" ]]; then
                    local IFS_old="$IFS"
                    IFS=':'
                    for p in $before_path; do
                        [[ -n "$p" ]] && ! path_list_contains "$p" "${prepend_parts[@]-}" && prepend_parts+=("${p%/}")
                    done
                    IFS="$IFS_old"
                fi
                
                # 分割并添加 append 部分
                if [[ -n "$after_path" ]]; then
                    local IFS_old="$IFS"
                    IFS=':'
                    for p in $after_path; do
                        [[ -n "$p" ]] && ! path_list_contains "$p" "${append_parts[@]-}" && append_parts+=("${p%/}")
                    done
                    IFS="$IFS_old"
                fi
            else
                # 没有 $PATH 引用，整行都是路径
                local IFS_old="$IFS"
                IFS=':'
                for p in $value; do
                    [[ -n "$p" ]] && ! path_list_contains "$p" "${prepend_parts[@]-}" && prepend_parts+=("${p%/}")
                done
                IFS="$IFS_old"
            fi
            continue
        fi
        
        # 保存非 PATH 行
        other_lines+=("$line")
    done < "$rc"
    
    if [[ $path_count -le 1 ]]; then
        success "PATH 定义正常 ($path_count 个)，无需合并"
        return
    fi
    
    info "发现 $path_count 个 PATH 定义，开始合并..."
    
    # 去重 prepend 部分（保持顺序）
    local unique_prepend=()
    for p in "${prepend_parts[@]}"; do
        path_list_contains "$p" "${unique_prepend[@]-}" || unique_prepend+=("$p")
    done
    
    # 去重 append 部分（保持顺序）
    local unique_append=()
    for p in "${append_parts[@]}"; do
        path_list_contains "$p" "${unique_prepend[@]-}" && continue
        path_list_contains "$p" "${unique_append[@]-}" || unique_append+=("$p")
    done

    # 组合最终 PATH: prepend + unique_paths + append
    local IFS=':'
    local final_path="${unique_prepend[*]:-}"
    if [[ ${#unique_append[@]} -gt 0 ]]; then
        if [[ -n "$final_path" ]]; then
            final_path="$final_path:${unique_append[*]}"
        else
            final_path="${unique_append[*]}"
        fi
    fi
    IFS=' '
    
    if [[ -z "$final_path" ]]; then
        warn "PATH 为空，保留原有定义"
        return
    fi
    
    # 写回文件
    local tmp
    tmp=$(mktemp)
    
    # 先写入合并后的 PATH
    echo "export PATH=\"$final_path\"" >> "$tmp"
    
    # 再写入其他行
    for line in "${other_lines[@]}"; do
        echo "$line" >> "$tmp"
    done
    
    mv "$tmp" "$rc"
    echo ""
    success "已完成合并，$path_count 个 PATH 定义合并为 1 个"
    info "Prepend 路径: ${#unique_prepend[@]} 个"
    info "Append 路径: ${#unique_append[@]} 个"
}

# ── 初始化 ────────────────────────────────────────────────────────────────
init_manager() {
    info "envmanager 初始化检查"
    echo ""
    
    # 检测当前 shell rc 文件
    for rc in ~/.zshrc ~/.bashrc ~/.zprofile; do
        if [[ -f "$rc" ]]; then
            local count
            count=$(count_path_exports "$rc")
            if [[ "$count" -gt 1 ]]; then
                warn "$rc 中有 $count 个 PATH 定义"
            else
                success "$rc: PATH 定义正常"
            fi
        fi
    done
    
    echo ""
    info "PATH 重复检查:"
    local current_path="$PATH"
    local IFS=':'
    local seen=()
    local duplicates=()
    
    for p in $current_path; do
        [[ -z "$p" ]] && continue
        if path_list_contains "$p" "${seen[@]-}"; then
            duplicates+=("$p")
        else
            seen+=("${p%/}")
        fi
    done
    
    if [[ ${#duplicates[@]} -gt 0 ]]; then
        warn "当前 PATH 中有 ${#duplicates[@]} 个重复目录:"
        for d in "${duplicates[@]}"; do
            echo "  - $d"
        done
        echo ""
        info "运行 'envs dedup' 修复"
    else
        success "当前 PATH 无重复"
    fi
    
    echo ""
    info "使用方法: $(basename "$0") add KEY=VALUE [rc_file]"
    info "完整帮助: $(basename "$0") --help"
}

# ── 修复单个 PATH 定义中的 $PATH 位置问题 ─────────────────────────────────
repair_path() {
    local rc="${1:-$DEFAULT_RC}"
    
    if [[ ! -f "$rc" ]]; then
        warn "文件不存在: $rc"
        return 1
    fi
    
    info "检查 $rc 中的 PATH 定义..."
    
    # 获取当前 PATH 行
    local path_line
    path_line=$(grep "^export PATH=" "$rc" 2>/dev/null || echo "")
    
    if [[ -z "$path_line" ]]; then
        warn "未找到 PATH 定义"
        return 1
    fi
    
    # 提取 VALUE
    local value="${path_line#*=}"
    value="${value#\"}"
    value="${value%\"}"
    value="${value#\'}"
    value="${value%\'}"
    
    if ! path_value_needs_cleanup "$value"; then
        success "$rc 中 PATH 定义正常（\$PATH 位置正确）"
        return 0
    fi
    
    echo ""
    warn "检测到 PATH 定义需要清理"
    echo ""
    info "当前 PATH: $value"
    
    # 备份
    backup_rc "$rc"
    
    local new_value
    new_value=$(rebuild_path_value "$value")
    
    echo ""
    info "修复后 PATH: $new_value"
    
    # 替换
    local tmp
    tmp=$(mktemp)
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^export[[:space:]]+PATH= ]]; then
            echo "export PATH=\"$new_value\"" >> "$tmp"
        else
            echo "$line" >> "$tmp"
        fi
    done < "$rc"
    mv "$tmp" "$rc"
    
    echo ""
    success "PATH 已修复"
}

# ── 检查是否需要修复 ───────────────────────────────────────────────────────
check_and_prompt_fix() {
    local rc="$DEFAULT_RC"
    local path_count
    path_count=$(count_path_exports "$rc")
    
    # 检查 PATH 内容是否有问题（包含 $PATH 在中间）
    local has_problem=false
    if [[ "$path_count" -eq 1 ]]; then
        local path_line
        path_line=$(grep "^export PATH=" "$rc" 2>/dev/null || echo "")
        local value="${path_line#*=}"
        value="${value#\"}"
        value="${value%\"}"
        value="${value#\'}"
        value="${value%\'}"
        if path_value_needs_cleanup "$value"; then
            has_problem=true
        fi
    fi
    
    if [[ "$path_count" -gt 1 ]]; then
        echo ""
        warn "检测到 $rc 中有 $path_count 个 PATH 定义，建议修复"
        echo ""
        info "运行以下命令修复:"
        echo "  $(basename "$0") fix"
        echo ""
        info "或查看帮助:"
        echo "  $(basename "$0") --help"
        return 1
    elif $has_problem; then
        echo ""
        warn "检测到 $rc 中 PATH 定义有问题（\$PATH 位置错误），建议修复"
        echo ""
        info "运行以下命令修复:"
        echo "  $(basename "$0") fix"
        echo ""
        return 1
    fi
    return 0
}

# ── 主逻辑 ────────────────────────────────────────────────────────────────
main() {
    local action="${1:-}"
    shift || true
    
    case "$action" in
        add|set)
            [[ -z "${1:-}" ]] && { error "缺少参数: KEY=VALUE"; exit 1; }
            add_var "$@"
            ;;
        remove|rm|del)
            [[ -z "${1:-}" ]] && { error "缺少参数: KEY"; exit 1; }
            remove_var "$@"
            ;;
        list|ls)
            list_vars "$@"
            ;;
        dedup)
            dedup_all "$@"
            ;;
        fix)
            # fix 命令：检测并修复 PATH 问题
            local rc="${1:-$DEFAULT_RC}"
            local path_count
            path_count=$(count_path_exports "$rc")
            
            # 检查是否有多行 PATH 定义
            if [[ "$path_count" -gt 1 ]]; then
                echo ""
                warn "检测到 $rc 中有 $path_count 个 PATH 定义:"
                grep "^export PATH=" "$rc" | nl
                echo ""
                info "将合并为单个去重的 PATH 定义"
                echo ""
                printf "确认修复? [Y/n] "
                read -r confirm
                if [[ "$confirm" =~ ^[Yy]$ ]] || [[ -z "$confirm" ]]; then
                    dedup_all "$rc"
                else
                    info "已取消"
                fi
                exit 0
            fi
            
            # 检查单个 PATH 定义是否有 $PATH 位置问题
            local path_line
            path_line=$(grep "^export PATH=" "$rc" 2>/dev/null || echo "")
            if [[ -n "$path_line" ]]; then
                local value="${path_line#*=}"
                value="${value#\"}"
                value="${value%\"}"
                value="${value#\'}"
                value="${value%\'}"
            else
                local value=""
            fi
            if [[ -n "$value" ]] && path_value_needs_cleanup "$value"; then
                repair_path "$rc"
            else
                success "$rc 中 PATH 定义正常，无需修复"
            fi
            ;;
        init|check)
            init_manager
            ;;
        backup|bak)
            backup_rc "${1:-$DEFAULT_RC}"
            ;;
        restore)
            [[ -z "${1:-}" ]] && { error "缺少参数: 备份文件路径"; exit 1; }
            restore_rc "$1"
            ;;
        -h|--help|help)
            usage
            ;;
        "")
            # 无参数时检查是否需要修复
            if ! check_and_prompt_fix; then
                exit 1
            fi
            usage
            ;;
        install|update)
            install_manager
            ;;
        *)
            error "未知操作: $action"
            usage
            ;;
    esac
}

# ── 安装/更新 ─────────────────────────────────────────────────────────────
install_manager() {
    # 检测自身位置
    local script_source="${BASH_SOURCE[0]:-./envs}"
    local script_dir
    script_dir=$(cd "$(dirname "$script_source")" && pwd) || script_dir="$PWD"
    local script_path="$script_dir/$(basename "$script_source")"

    # 确定安装目标
    local install_dir="$HOME/.local/bin"
    local install_path="$install_dir/envs"

    # 检测更合适的 bin 目录
    if [[ -d "/opt/homebrew/bin" ]] && [[ "$(uname)" == "Darwin" ]]; then
        install_dir="/opt/homebrew/bin"
        install_path="/opt/homebrew/bin/envs"
    elif [[ -d "/usr/local/bin" ]] && [[ -w "/usr/local/bin" ]]; then
        install_dir="/usr/local/bin"
        install_path="/usr/local/bin/envs"
    fi

    mkdir -p "$install_dir"

    # 复制到目标位置
    if cp "$script_path" "$install_path" 2>/dev/null || cp "$0" "$install_path" 2>/dev/null; then
        chmod +x "$install_path"
        success "envs 已安装到: $install_path"
    else
        error "安装失败，请检查权限或手动复制: cp $script_path $install_path"
        exit 1
    fi

    echo ""
    info "添加到 shell 环境..."

    # 检测当前 shell
    local shell_rc=""
    if [[ -n "${ZSH_VERSION:-}" ]]; then
        shell_rc="$HOME/.zshrc"
    elif [[ -n "${BASH_VERSION:-}" ]]; then
        for f in "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"; do
            [[ -f "$f" ]] && shell_rc="$f" && break
        done
        shell_rc="${shell_rc:-$HOME/.bashrc}"
    fi

    # 检查 PATH 是否已包含安装目录
    if [[ ":${PATH}:" != *":${install_dir}:"* ]]; then
        if [[ -f "$shell_rc" ]] && ! grep -q "${install_dir}" "$shell_rc" 2>/dev/null; then
            echo "" >> "$shell_rc"
            echo "# envs (environment variable manager)" >> "$shell_rc"
            echo "export PATH=\"${install_dir}:\$PATH\"" >> "$shell_rc"
            success "已将 ${install_dir} 添加到 $shell_rc"
            echo ""
            info "请运行以下命令生效: source $shell_rc"
        else
            info "${install_dir} 未添加到 $shell_rc，请手动添加:"
            echo "  export PATH=\"${install_dir}:\$PATH\""
        fi
    else
        success "${install_dir} 已在 PATH 中"
    fi

    echo ""
    success "安装完成！运行 'envs --help' 查看用法"
    echo ""
    info "常用命令:"
    echo "  envs add  KEY=VALUE    # 添加/更新变量"
    echo "  envs dedup ~/.zshrc    # 去重 PATH"
    echo "  envs init              # 检查 PATH 状态"
}

main "$@"
