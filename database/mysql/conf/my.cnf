[mysqld]
# ================= 通用配置 =================
port = 3306
basedir = /opt/mysql
# 数据目录
#datadir = /opt/mysql/data
socket = /tmp/mysql.sock
log-error = /var/log/mysql/error.log
pid-file = /opt/mysql/data/mysqld.pid
user = mysql
bind-address = 0.0.0.0

# 字符集与排序
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

# 连接与缓存
max_allowed_packet = 128M
max_connections = 200
thread_stack = 256K
table_open_cache = 4096
lower_case_table_names = 1

# InnoDB 配置
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 2
innodb_log_file_size = 128M
innodb_log_buffer_size = 32M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1

# 日志与慢查询
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 10
min_examined_row_limit = 250

# 二进制日志
log_bin = /var/log/mysql/mysql-bin.log
log_bin_index = /var/log/mysql/mysql-bin.index
max_binlog_size = 100M
expire_logs_days = 7
binlog_format = ROW
server_id = 1

# SQL模式
sql_mode = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION

# ================= MySQL 8 专属配置 =================
performance_schema = ON
log_error_verbosity = 2  # MySQL 5.7+/8 支持，5.6及以下请注释
#default_authentication_plugin = mysql_native_password  # 仅MySQL 8 支持

# ================= MySQL 5 专属配置（如有特殊需求可取消注释） =================
#skip-name-resolve
#explicit_defaults_for_timestamp = 1  # MySQL 5.6.6+/8 支持

# 时区
#default-time-zone = '+00:00'  # MySQL 5.6+ 支持

# GTID
#gtid_mode = OFF  # MySQL 5.6+/8 支持
#enforce_gtid_consistency = OFF  # MySQL 5.6+/8 支持

[client]
# 设置默认字符集
default-character-set = utf8mb4
socket = /opt/mysql/mysql.sock

[mysql]
# 禁用自动重新哈希
no-auto-rehash