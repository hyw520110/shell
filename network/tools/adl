        return 1
    fi

    log_error "Homebrew 安装失败"
    return 1
}

# === 智能重试策略 ===
# 小文件（<100MB）：有限次数重试
# 大文件（≥100MB）：无限重试，利用断点续传
smart_retry_logic() {
    local attempt="$1"
    local max_small_file_attempts="${ADL_MAX_RETRIES_SMALL:-5}"
    local max_large_file_attempts="${ADL_MAX_RETRIES_LARGE:-0}"  # 0 表示无限
    local remote_size="$2"
    local small_file_threshold=$((100 * 1024 * 1024))  # 100MB

    if [[ "$remote_size" -ge "$small_file_threshold" ]]; then
        # 大文件：0 表示无限，否则最多 N 次
        [[ "$max_large_file_attempts" -eq 0 ]] && return 0
        [[ $attempt -le $max_large_file_attempts ]] && return 0
    else
        # 小文件：最多 N 次
        [[ $attempt -le $max_small_file_attempts ]] && return 0
    fi

    return 1
}

# 计算重试等待时间（指数退避）
get_retry_wait() {
    local attempt="$1"
    local base_wait="${ADL_RETRY_BASE_WAIT:-2}"
    local max_wait="${ADL_RETRY_MAX_WAIT:-60}"

    local wait=$((base_wait * (2 ** (attempt - 1))))
    [[ $wait -gt $max_wait ]] && wait=$max_wait
    echo $wait
}

