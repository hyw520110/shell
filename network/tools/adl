#!/bin/bash

# adl (Aria2 Downloader) - 并行下载加速与自动环境配置工具
# 功能：
#   - 自动安装 aria2，提供并行、断点续传下载
#   - 检测代理端口，可用则配置代理，不可用则绕过
#   - 下载失败自动重试（小文件有限次数，大文件无限重试）
#   - 支持自动配置环境变量

set -euo pipefail

# === 颜色定义 ===
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly NC='\033[0m'

# === 日志函数 ===
log_info() { echo -e "${GREEN}[INFO]${NC} $*" >&2; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*" >&2; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }
success() { echo -e "${GREEN}[OK]${NC} $*" >&2; }

# === 检测系统 ===
detect_os() {
    case "$(uname -s)" in
        Darwin*) echo "macos" ;;
        Linux*) echo "linux" ;;
        *) echo "unknown" ;;
    esac
}

# === 真实代理验证 - 使用实际请求测试 ===
verify_proxy_available() {
    local proxy_url="$1"
    local test_url="${ADL_PROXY_TEST_URL:-https://github.com/favicon.ico}"
    local timeout="${ADL_PROXY_TEST_TIMEOUT:-5}"

    command -v curl >/dev/null 2>&1 || return 1

    if env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u all_proxy -u no_proxy -u NO_PROXY \
        curl -f -L --connect-timeout "$timeout" --max-time "$timeout" \
        --proxy "$proxy_url" \
        -o /dev/null -s "$test_url" >/dev/null 2>&1; then
        return 0
    fi

    return 1
}

normalize_proxy_url() {
    local proxy_str="$1"

    if [[ "$proxy_str" != *"://"* ]]; then
        proxy_str="http://${proxy_str}"
    fi

    printf '%s\n' "$proxy_str"
}

proxy_host_port() {
    local proxy_url="$1"
    local endpoint host port

    endpoint="${proxy_url#*://}"
    endpoint="${endpoint#*@}"
    endpoint="${endpoint%%/*}"

    [[ "$endpoint" == *:* ]] || return 1
    host="${endpoint%:*}"
    port="${endpoint##*:}"
    [[ -n "$host" && "$port" =~ ^[0-9]+$ ]] || return 1

    printf '%s\t%s\n' "$host" "$port"
}

is_interactive_terminal() {
    [[ -t 0 && -t 1 ]]
}

tcp_port_open() {
    local host="$1"
    local port="$2"

    command -v nc >/dev/null 2>&1 || return 1

    nc -z -G 1 "$host" "$port" >/dev/null 2>&1 && return 0
    nc -z -w 1 "$host" "$port" >/dev/null 2>&1 && return 0
    return 1
}

# === 解析完整代理URL并验证 ===
parse_and_verify_proxy() {
    local proxy_str="$1"

    proxy_str=$(normalize_proxy_url "$proxy_str")

    if verify_proxy_available "$proxy_str"; then
        printf '%s\n' "$proxy_str"
        return 0
    fi

    return 1
}

clear_proxy_env() {
    unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY all_proxy
    export no_proxy="*"
    export NO_PROXY="*"
}

set_proxy_env() {
    local proxy_var="$1"
    export http_proxy="$proxy_var"
    export https_proxy="$proxy_var"
    export HTTP_PROXY="$proxy_var"
    export HTTPS_PROXY="$proxy_var"
    export ALL_PROXY="$proxy_var"
    export all_proxy="$proxy_var"
    unset no_proxy NO_PROXY
}

confirm_lan_proxy_scan() {
    local default="${ADL_LAN_PROXY_SCAN_DEFAULT:-yes}"
    local prompt_suffix="[Y/n]"
    local answer

    [[ "${ADL_LAN_PROXY_SCAN:-ask}" != "ask" ]] && return 1
    is_interactive_terminal || return 1

    case "$default" in
        0|false|False|FALSE|no|No|NO|n|N)
            prompt_suffix="[y/N]"
            ;;
    esac

    read -r -p "未检测到可用本地代理，是否探测局域网代理服务? ${prompt_suffix}: " answer
    if [[ -z "$answer" ]]; then
        answer="$default"
    fi

    case "$answer" in
        y|Y|yes|Yes|YES|1|true|True|TRUE) return 0 ;;
        *) return 1 ;;
    esac
}

get_lan_hosts() {
    local ip=""
    local prefix=""
    local scan_full="${ADL_LAN_PROXY_SCAN_FULL:-1}"

    if command -v ipconfig >/dev/null 2>&1; then
        ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)
    fi

    if [[ -z "$ip" ]] && command -v hostname >/dev/null 2>&1; then
        ip=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
    fi

    if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        prefix="${ip%.*}"
        if [[ "$scan_full" == "1" || "$scan_full" == "true" || "$scan_full" == "yes" ]]; then
            local i
            for i in $(seq 1 254); do
                printf '%s\n' "${prefix}.${i}"
            done
        else
            printf '%s\n' "${prefix}.1"
            printf '%s\n' "${prefix}.2"
            printf '%s\n' "${prefix}.100"
            printf '%s\n' "${prefix}.254"
        fi
    fi

    # 常见网关/宿主机地址，去重由调用方处理。
    printf '%s\n' \
        "192.168.0.1" "192.168.1.1" "192.168.2.1" \
        "10.0.0.1" "172.16.0.1" \
        "host.docker.internal"
}

find_lan_proxy() {
    local ports=(
        7890
        7891
        7897
        1080
        8118
        10871
    )
    local schemes=("http" "socks5h")
    local tmpdir
    local pids=()
    local seen_hosts=""
    local max_wait_tenths="${ADL_LAN_PROXY_SCAN_WAIT_TENTHS:-80}"
    local max_jobs="${ADL_LAN_PROXY_SCAN_JOBS:-64}"
    local active_jobs=0

    tmpdir=$(mktemp -d)
    log_info "正在探测局域网常见代理服务..."

    wait_for_scan_batch() {
        local pid
        for pid in "${pids[@]}"; do
            wait "$pid" 2>/dev/null || true
        done
        pids=()
        active_jobs=0
    }

    wait_for_scan_slot() {
        while [[ "$active_jobs" -ge "$max_jobs" ]]; do
            wait_for_scan_batch
        done
    }

    while IFS= read -r host; do
        [[ -n "$host" ]] || continue
        case " $seen_hosts " in
            *" $host "*) continue ;;
        esac
        seen_hosts="${seen_hosts} ${host}"

        for port in "${ports[@]}"; do
            wait_for_scan_slot
            (
                tcp_port_open "$host" "$port" || exit 0
                printf '%s\t%s\n' "$host" "$port" >> "$tmpdir/open"
            ) &
            pids+=("$!")
            active_jobs=$((active_jobs + 1))
        done
    done < <(get_lan_hosts)

    wait_for_scan_batch

    local proxy_var=""
    local host port scheme proxy verified
    if [[ -f "$tmpdir/open" ]]; then
        while IFS=$'\t' read -r host port; do
            for scheme in "${schemes[@]}"; do
                proxy="${scheme}://${host}:${port}"
                if verified=$(parse_and_verify_proxy "$proxy" 2>/dev/null); then
                    proxy_var="$verified"
                    break 2
                fi
            done
        done < "$tmpdir/open"
    fi

    rm -rf "$tmpdir"

    [[ -n "$proxy_var" ]] || return 1
    log_info "检测到局域网代理: $proxy_var"
    printf '%s\n' "$proxy_var"
}

find_available_proxy() {
    # 常见的代理端口
    local common_proxies=(
        "http://127.0.0.1:7890"   # Clash/V2Ray 默认
        "socks5h://127.0.0.1:7890" # Clash mixed/SOCKS，远端解析 DNS
        "socks5://127.0.0.1:7890"
        "http://127.0.0.1:7891"   # Clash Meta
        "socks5h://127.0.0.1:7891"
        "http://127.0.0.1:7897"   # Clash Verge/部分客户端
        "socks5h://127.0.0.1:7897"
        "socks5://127.0.0.1:1080"  # 通用代理
        "socks5h://127.0.0.1:1080"
        "http://127.0.0.1:8118"   # Privoxy
        "socks5://127.0.0.1:10871"  # SOCKS
        "socks5h://127.0.0.1:10871"
    )

    local proxy_var=""
    local listened_proxies=()
    local proxy_mode="${ADL_PROXY_MODE:-auto}"

    # 显式指定代理优先级最高；ADL_PROXY_MODE=proxy 时允许跳过验证强制使用。
    if [[ -n "${ADL_PROXY:-}" ]]; then
        local explicit_proxy
        explicit_proxy=$(normalize_proxy_url "$ADL_PROXY")
        if verified=$(parse_and_verify_proxy "$explicit_proxy" 2>/dev/null); then
            log_info "使用 ADL_PROXY 指定代理: $verified"
            printf '%s\n' "$verified"
            return 0
        fi

        if [[ "$proxy_mode" == "proxy" ]]; then
            log_warn "ADL_PROXY 验证失败，但已按 ADL_PROXY_MODE=proxy 强制使用: $explicit_proxy"
            printf '%s\n' "$explicit_proxy"
            return 0
        fi

        log_warn "ADL_PROXY 验证失败，将继续检测其他代理: $explicit_proxy"
    fi

    # 先检查环境变量中的代理
    for var in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY; do
        local val="${!var:-}"
        if [[ -n "$val" ]]; then
            local verified
            if verified=$(parse_and_verify_proxy "$val" 2>/dev/null); then
                log_info "检测到环境变量代理: $verified"
                proxy_var="$verified"
                break
            elif [[ "$proxy_mode" == "proxy" ]]; then
                local normalized
                normalized=$(normalize_proxy_url "$val")
                log_warn "$var 验证失败，但已按 ADL_PROXY_MODE=proxy 强制使用: $normalized"
                proxy_var="$normalized"
                break
            fi
        fi
    done

    # 如果环境变量没有，并行扫描常见端口
    if [[ -z "$proxy_var" ]]; then
        log_info "正在并行检测常见代理端口..."
        local tmpdir
        tmpdir=$(mktemp -d)
        local pids=()

        for proxy in "${common_proxies[@]}"; do
            (
                local verified
                if verified=$(parse_and_verify_proxy "$proxy" 2>/dev/null); then
                    printf '%s\n' "$verified" > "$tmpdir/ok"
                else
                    local hp host port
                    if hp=$(proxy_host_port "$proxy" 2>/dev/null); then
                        IFS=$'\t' read -r host port <<< "$hp"
                        if tcp_port_open "$host" "$port"; then
                            printf '%s\t%s\n' "$proxy" "listened" >> "$tmpdir/listened"
                        fi
                    fi
                fi
            ) &
            pids+=("$!")
        done

        # 等待第一个成功的结果（最多3秒）
        local waited=0
        while [[ "$waited" -lt 30 ]]; do
            if [[ -f "$tmpdir/ok" ]]; then
                proxy_var=$(head -1 "$tmpdir/ok")
                log_info "检测到代理: $proxy_var"
                break
            fi
            sleep 0.1
            waited=$((waited + 1))
        done

        # 清理后台进程
        for pid in "${pids[@]}"; do
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
        done

        # 收集监听的代理（用于提示）
        if [[ -f "$tmpdir/listened" ]]; then
            while IFS=$'\t' read -r proxy _; do
                listened_proxies+=("$proxy")
            done < "$tmpdir/listened"
        fi

        rm -rf "$tmpdir"

        # 如果并行探测未找到但 proxy_mode=proxy，使用第一个监听的
        if [[ -z "$proxy_var" && "${#listened_proxies[@]}" -gt 0 && "$proxy_mode" == "proxy" ]]; then
            proxy_var="${listened_proxies[0]}"
            log_warn "代理端口已监听但请求验证失败，按 ADL_PROXY_MODE=proxy 使用: $proxy_var"
        fi
    fi

    if [[ -z "$proxy_var" && "${#listened_proxies[@]}" -gt 0 ]]; then
        log_warn "检测到代理端口监听但验证请求失败: ${listened_proxies[*]}"
        log_warn "如需强制使用，可设置: ADL_PROXY=${listened_proxies[0]} ADL_PROXY_MODE=proxy"
    fi

    if [[ -z "$proxy_var" ]]; then
        case "${ADL_LAN_PROXY_SCAN:-ask}" in
            1|true|True|TRUE|yes|Yes|YES|on|ON)
                proxy_var=$(find_lan_proxy || true)
                ;;
            ask)
                if confirm_lan_proxy_scan; then
                    proxy_var=$(find_lan_proxy || true)
                fi
                ;;
        esac
    fi

    [[ -n "$proxy_var" ]] || return 1
    printf '%s\n' "$proxy_var"
}

measure_download_speed() {
    local url="$1"
    local mode="$2"
    local proxy_var="${3:-}"
    local timeout="${ADL_SPEED_TEST_SECONDS:-8}"
    local bytes="${ADL_SPEED_TEST_BYTES:-1048576}"
    local speed=""

    command -v curl >/dev/null 2>&1 || { echo 0; return 0; }

    if [[ "$mode" == "proxy" ]]; then
        speed=$(env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u all_proxy \
            curl -fL --range "0-$((bytes - 1))" --max-redirs 10 \
            --connect-timeout 5 --max-time "$timeout" \
            --proxy "$proxy_var" \
            -o /dev/null -sS -w "%{speed_download}" "$url" 2>/dev/null || true)
    else
        speed=$(env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u all_proxy \
            curl -fL --range "0-$((bytes - 1))" --max-redirs 10 \
            --connect-timeout 5 --max-time "$timeout" \
            --noproxy "*" \
            -o /dev/null -sS -w "%{speed_download}" "$url" 2>/dev/null || true)
    fi

    awk -v s="${speed:-0}" 'BEGIN { if (s > 0) printf "%d\n", s; else print 0 }'
}

get_file_size_bytes() {
    local file="$1"
    [[ -f "$file" ]] || { echo 0; return 0; }

    if [[ "$(uname -s)" == "Darwin" ]]; then
        stat -f%z "$file" 2>/dev/null || echo 0
    else
        stat -c%s "$file" 2>/dev/null || echo 0
    fi
}

get_remote_size_bytes() {
    local url="$1"
    local mode="$2"
    local proxy_var="${3:-}"
    local header=""

    command -v curl >/dev/null 2>&1 || { echo 0; return 0; }

    if [[ "$mode" == "proxy" ]]; then
        header=$(env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u all_proxy \
            curl -fIL --max-redirs 10 --connect-timeout 5 --max-time 10 \
            --proxy "$proxy_var" "$url" 2>/dev/null || true)
    else
        header=$(env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u all_proxy \
            curl -fIL --max-redirs 10 --connect-timeout 5 --max-time 10 \
            --noproxy "*" "$url" 2>/dev/null || true)
    fi

    local size
    size=$(awk '{
            line=tolower($0)
        }
        line ~ /^content-length:/ {
            gsub("\r", "", $2)
            size=$2
        }
        line ~ /^content-range:/ {
            gsub("\r", "", $0)
            if (match($0, /\/[0-9]+$/)) size=substr($0, RSTART + 1)
        }
        END {if (size ~ /^[0-9]+$/) print size; else print 0}' <<< "$header")

    if [[ "${size:-0}" -gt 0 ]]; then
        echo "$size"
        return 0
    fi

    # 部分代理或服务器对 HEAD 不返回 Content-Length；用 0-0 Range GET 兜底。
    if [[ "$mode" == "proxy" ]]; then
        header=$(env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u all_proxy \
            curl -fsSL --range 0-0 -D - --max-redirs 10 --connect-timeout 5 --max-time 10 \
            --proxy "$proxy_var" -o /dev/null "$url" 2>/dev/null || true)
    else
        header=$(env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u all_proxy \
            curl -fsSL --range 0-0 -D - --max-redirs 10 --connect-timeout 5 --max-time 10 \
            --noproxy "*" -o /dev/null "$url" 2>/dev/null || true)
    fi

    awk '{
            line=tolower($0)
        }
        line ~ /^content-range:/ {
            gsub("\r", "", $0)
            if (match($0, /\/[0-9]+$/)) size=substr($0, RSTART + 1)
        }
        END {if (size ~ /^[0-9]+$/) print size; else print 0}' <<< "$header"
}

expected_size_bytes() {
    if [[ "${ADL_EXPECTED_SIZE_BYTES:-0}" =~ ^[0-9]+$ && "${ADL_EXPECTED_SIZE_BYTES:-0}" -gt 0 ]]; then
        echo "$ADL_EXPECTED_SIZE_BYTES"
        return 0
    fi
    if [[ "${ADL_EXPECTED_SIZE_GB:-0}" =~ ^[0-9]+$ && "${ADL_EXPECTED_SIZE_GB:-0}" -gt 0 ]]; then
        echo $((ADL_EXPECTED_SIZE_GB * 1024 * 1024 * 1024))
        return 0
    fi
    echo 0
}

remote_size_is_suspicious() {
    local url="$1"
    local filename="$2"
    local remote_size="$3"
    local expected_size

    [[ "$remote_size" =~ ^[0-9]+$ ]] || return 0
    [[ "$remote_size" -gt 0 ]] || return 0

    expected_size=$(expected_size_bytes)
    if [[ "$expected_size" -gt 0 && "$remote_size" -lt $((expected_size / 10)) ]]; then
        return 0
    fi

    # Hugging Face/Xet 的大文件 HEAD 有时只返回 LFS pointer/元数据大小。
    if [[ "$filename" == *.gguf || "$url" == *"huggingface.co"* || "$url" == *"xethub.hf.co"* ]]; then
        [[ "$remote_size" -lt $((1024 * 1024 * 1024)) ]] && return 0
    fi

    return 1
}

format_bytes() {
    local bytes="${1:-0}"
    awk -v b="$bytes" 'BEGIN {
        if (b >= 1073741824) printf "%.2f GiB", b / 1073741824;
        else if (b >= 1048576) printf "%.2f MiB", b / 1048576;
        else if (b >= 1024) printf "%.1f KiB", b / 1024;
        else printf "%d B", b;
    }'
}

format_speed() {
    local speed="${1:-0}"
    awk -v s="$speed" 'BEGIN {
        if (s >= 1048576) printf "%.2f MiB/s", s / 1048576;
        else if (s >= 1024) printf "%.1f KiB/s", s / 1024;
        else printf "%d B/s", s;
    }'
}

should_skip_proxy_speed_test() {
    local url="$1"
    local dir="$2"
    local filename="$3"
    local proxy_var="$4"
    local skip_bytes="${ADL_PROXY_SPEED_TEST_SKIP_BYTES:-67108864}"
    local skip_seconds="${ADL_PROXY_SPEED_TEST_SKIP_SECONDS:-30}"
    local assumed_speed="${ADL_PROXY_SPEED_TEST_ASSUME_BPS:-5242880}"
    local remote_size=0
    ADL_REMOTE_SIZE_MODE="direct"

    remote_size=$(get_remote_size_bytes "$url" "direct")
    if [[ "$remote_size" -eq 0 && -n "$proxy_var" ]]; then
        remote_size=$(get_remote_size_bytes "$url" "proxy" "$proxy_var")
        [[ "$remote_size" -gt 0 ]] && ADL_REMOTE_SIZE_MODE="proxy"
    fi

    [[ "$remote_size" -gt 0 ]] || return 1
    if remote_size_is_suspicious "$url" "$filename" "$remote_size"; then
        log_warn "远端大小探测结果异常: $(format_bytes "$remote_size")，将按大文件处理并继续测速。"
        return 1
    fi

    local local_size remaining estimated_seconds
    local_size=$(get_file_size_bytes "$dir/$filename")
    if [[ "$local_size" -gt "$remote_size" ]]; then
        local_size=0
    fi
    remaining=$((remote_size - local_size))
    estimated_seconds=$(( (remaining + assumed_speed - 1) / assumed_speed ))

    if [[ "$remaining" -le "$skip_bytes" ]]; then
        log_info "剩余文件较小，跳过代理测速。"
        return 0
    fi

    if [[ "$estimated_seconds" -le "$skip_seconds" ]]; then
        log_info "预计下载时间较短，跳过代理测速。"
        return 0
    fi

    return 1
}

# === 自动检测并配置代理 ===
detect_and_config_proxy() {
    local url="${1:-}"
    local dir="${2:-}"
    local filename="${3:-}"

    if [[ "${ADL_NO_PROXY:-0}" == "1" || "${ADL_DISABLE_PROXY:-0}" == "1" || "${ADL_PROXY_MODE:-auto}" == "direct" ]]; then
        log_info "已按配置禁用代理，将直连下载"
        clear_proxy_env
        return 0
    fi

    local proxy_var=""
    proxy_var=$(find_available_proxy || true)

    if [[ -z "$proxy_var" ]]; then
        log_warn "未检测到可用代理，将直连下载"
        clear_proxy_env
        return 0
    fi

    if [[ "${ADL_PROXY_MODE:-auto}" == "proxy" ]]; then
        set_proxy_env "$proxy_var"
        log_info "已按 ADL_PROXY_MODE=proxy 强制使用代理: $proxy_var"
        return 0
    fi

    if [[ -z "$url" || "${ADL_PROXY_SPEED_TEST:-1}" == "0" ]]; then
        set_proxy_env "$proxy_var"
        log_info "代理已配置: $proxy_var"
        return 0
    fi

    if [[ -n "$dir" && -n "$filename" ]] && should_skip_proxy_speed_test "$url" "$dir" "$filename" "$proxy_var"; then
        # 跳过测速时默认使用代理（未测速无法证明直连可用）
        set_proxy_env "$proxy_var"
        log_info "跳过测速，使用代理下载: $proxy_var"
        return 0
    fi

    log_info "开始测速以选择直连或代理..."
    local direct_speed proxy_speed
    direct_speed=$(measure_download_speed "$url" "direct")
    proxy_speed=$(measure_download_speed "$url" "proxy" "$proxy_var")
    log_info "直连测速: $(format_speed "$direct_speed")；代理测速: $(format_speed "$proxy_speed")"

    if [[ "$direct_speed" -gt 0 && "$direct_speed" -ge "$proxy_speed" ]]; then
        clear_proxy_env
        log_info "选择直连下载"
    elif [[ "$proxy_speed" -gt 0 ]]; then
        set_proxy_env "$proxy_var"
        if [[ "$direct_speed" -eq 0 ]]; then
            log_info "直连不可用，选择代理下载: $proxy_var"
        else
            log_info "选择代理下载: $proxy_var"
        fi
    else
        clear_proxy_env
        log_warn "直连和代理测速均失败，先尝试直连下载"
    fi
}

# 只刷新当前进程 PATH，不写入 ~/.zshrc 或其他 shell 配置。
refresh_homebrew_path() {
    local brew_bin
    for brew_bin in /opt/homebrew/bin /usr/local/bin /home/linuxbrew/.linuxbrew/bin; do
        [[ -d "$brew_bin" ]] || continue
        case ":${PATH:-}:" in
            *":$brew_bin:"*) ;;
            *)
                if [[ -n "${PATH:-}" ]]; then
                    PATH="$brew_bin:$PATH"
                else
                    PATH="$brew_bin"
                fi
                ;;
        esac
    done
    export PATH
}

sudo_user_has_homebrew() {
    local user="$1"
    sudo -u "$user" bash -lc 'command -v brew >/dev/null 2>&1 || [[ -x /opt/homebrew/bin/brew || -x /usr/local/bin/brew || -x /home/linuxbrew/.linuxbrew/bin/brew ]]'
}

install_aria2_for_sudo_user() {
    local user="$1"
    sudo -u "$user" bash -lc '
        if command -v brew >/dev/null 2>&1; then
            brew install aria2
        elif [[ -x /opt/homebrew/bin/brew ]]; then
            /opt/homebrew/bin/brew install aria2
        elif [[ -x /usr/local/bin/brew ]]; then
            /usr/local/bin/brew install aria2
        elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
            /home/linuxbrew/.linuxbrew/bin/brew install aria2
        else
            exit 127
        fi

        command -v aria2c >/dev/null 2>&1 || [[ -x /opt/homebrew/bin/aria2c || -x /usr/local/bin/aria2c || -x /home/linuxbrew/.linuxbrew/bin/aria2c ]]
    ' 2>&1
}

# === 安全的自动安装 Homebrew (macOS) ===
ensure_homebrew() {
    if [[ "${ADL_AUTO_INSTALL:-0}" != "1" ]]; then
        log_info "ADL_AUTO_INSTALL=0，跳过自动安装 Homebrew"
        return 1
    fi

    refresh_homebrew_path

    if command -v brew &> /dev/null; then
        local brew_version
        brew_version=$(brew --version 2>/dev/null | head -1 || true)
        if [[ -n "$brew_version" ]]; then
            log_info "Homebrew 已安装: $brew_version"
        else
            log_info "Homebrew 已安装"
