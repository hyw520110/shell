        if [[ -n "${SUDO_USER:-}" ]]; then
            log_info "尝试通过 sudo 用户 $SUDO_USER 安装..."

            if sudo_user_has_homebrew "$SUDO_USER"; then
                log_info "Homebrew 在用户空间已安装"
                return 0
            fi

            if curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh | sudo -u "$SUDO_USER" env NONINTERACTIVE=1 /bin/bash 2>&1; then
                log_info "Homebrew 安装完成"
                refresh_homebrew_path
                return 0
            fi
        fi

        log_error "无法以 root 用户安装 Homebrew"
        log_info "建议：以普通用户身份运行 adl，或手动安装 aria2"
        return 1
    fi

    log_info "正在安装 Homebrew..."

    # 使用国内镜像加速
    export HOMEBREW_INSTALL_FROM_API=1
