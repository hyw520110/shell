    <plugins>
        <simpleAuthenticationPlugin>
            <users>
                <authenticationUser username="admin" password="ADMIN_PASSWORD" groups="admins,users"/>
                <authenticationUser username="user" password="USER_PASSWORD" groups="users"/>
            </users>
        </simpleAuthenticationPlugin>
        
        <authorizationPlugin>
            <map>
                <authorizationMap>
                    <authorizationEntries>
                        <authorizationEntry queue=">" write="admins" read="users" admin="admins" />
                        <authorizationEntry topic=">" write="admins" read="users" admin="admins" />
                        <authorizationEntry topic="ActiveMQ.Advisory.>" read="users" write="users" admin="users" />
                    </authorizationEntries>
                </authorizationMap>
            </map>
        </authorizationPlugin>
    </plugins>